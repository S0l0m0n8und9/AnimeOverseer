<Project>
  <PropertyGroup>
    <!--
      Configure these in LocalWindowsServer.pubxml.user so server details are not committed.
      Example:
      <DeployServerHost>192.168.1.50</DeployServerHost>
      <DeployServerUser>administrator</DeployServerUser>
    -->
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- This is overridden by the local .pubxml.user file to stay outside the repository. -->
    <PublishDir>$(BaseIntermediateOutputPath)publish\</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
    <Configuration>Release</Configuration>
    <DeleteExistingFiles>False</DeleteExistingFiles>
    <DeployScript>$(MSBuildProjectDirectory)\..\deploy-local-server.ps1</DeployScript>
    <!-- Creates deploy-{timestamp}-{commit}; set PushGitTag to false to keep the tag local. -->
    <GitTagPrefix>deploy-</GitTagPrefix>
    <PushGitTag>true</PushGitTag>
    <DeployServerHost Condition="'$(DeployServerHost)' == ''">SET_IN_PUBXML_USER</DeployServerHost>
    <DeployServerUser Condition="'$(DeployServerUser)' == ''">SET_IN_PUBXML_USER</DeployServerUser>
  </PropertyGroup>

  <Target Name="DeployDockerImageToLocalWindowsServer" AfterTargets="Publish">
    <Error Condition="'$(DeployServerHost)' == 'SET_IN_PUBXML_USER' Or '$(DeployServerUser)' == 'SET_IN_PUBXML_USER'"
           Text="Set DeployServerHost and DeployServerUser in LocalWindowsServer.pubxml.user before publishing." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(DeployScript)&quot; -ServerHost &quot;$(DeployServerHost)&quot; -ServerUser &quot;$(DeployServerUser)&quot; -GitTagPrefix &quot;$(GitTagPrefix)&quot; -PushGitTag:$(PushGitTag)" />
  </Target>
</Project>
