@using AnimeOverseer.Server.Models
@using AnimeOverseer.Server.Services
@inject MediaRequestService MediaRequestService
@inject MediaLibraryService MediaLibraryService

<div class="anime-card @(Draggable ? "anime-card-draggable" : "")" draggable="@Draggable" @ondragstart="OnDragStart" @ondragend="OnDragEnd">
    <a class="anime-card-link" href="/anime/@Anime.Id" aria-label="View @(Anime.Title ?? Anime.OriginalTitle) details"></a>
    <div class="card-image-wrapper">
        @if (!string.IsNullOrEmpty(Anime.DisplayLocalImagePath) || !string.IsNullOrEmpty(Anime.DisplayImageUrl))
        {
            <img src="@(Anime.DisplayLocalImagePath ?? Anime.DisplayImageUrl)" alt="@Anime.Title cover" class="card-image" onerror="this.src='/images/placeholder.png'; this.onerror=null;" />
        }
        else
        {
            <div class="card-placeholder">
                <span>&#x1F3AC;</span>
            </div>
        }
        <div class="card-overlay">
            @if (!_inLibrary)
            {
                @if (Anime.Type == "TV" || Anime.Type == "Movie")
                {
                    <button class="card-request-btn @(_requestResult.HasValue ? (_requestResult.Value.Ok ? "req-ok" : "req-err") : "")"
                            @onclick="() => RequestAsync()" @onclick:stopPropagation="true"
                            disabled="@_isRequesting">
                        @if (_isRequesting)
                        {
                            <span>•••</span>
                        }
                        else if (_requestResult.HasValue)
                        {
                            @(_requestResult.Value.Ok ? "✓ Added" : "✗ Error")
                        }
                        else
                        {
                            @($"+ {(Anime.Type == "Movie" ? "Radarr" : "Sonarr")}")
                        }
                    </button>
                }
                else
                {
                    <button class="card-request-btn" @onclick="() => RequestAsync(useRadarr: false)" @onclick:stopPropagation="true" disabled="@_isRequesting">+ Sonarr</button>
                    <button class="card-request-btn" @onclick="() => RequestAsync(useRadarr: true)" @onclick:stopPropagation="true" disabled="@_isRequesting">+ Radarr</button>
                }
            }
            else if (!string.IsNullOrEmpty(Anime.Type))
            {
                <span class="type-badge">@Anime.Type</span>
            }
            @if (Anime.Episodes.HasValue)
            {
                <span class="episodes-badge">@Anime.Episodes.Value EP</span>
            }
            @if (_inLibrary)
            {
                <span class="in-library-badge" title="In Library" aria-label="In Library">&#x2713; Library</span>
            }
        </div>
    </div>

    <div class="card-content">
        <h3 class="card-title" title="@(Anime.Title ?? Anime.OriginalTitle)">@(Anime.Title ?? Anime.OriginalTitle)</h3>
        <p class="original-title-text">@Anime.OriginalTitle</p>

        <div class="card-footer">
            <div class="rating-badge">
                @if (Anime.Rating.HasValue)
                {
                    <span class="rating-icon">&#x2605;</span>
                    <span class="rating-value">@Anime.Rating.Value.ToString("F1")</span>
                }
                else
                {
                    <span class="no-rating">N/A</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Anime.Status))
            {
                <span class="status-badge status-@(NormalizeStatus(Anime.Status))">@Anime.Status</span>
            }
        </div>
    </div>
</div>

@if (_showPicker && _pickerResults != null)
{
    <MediaPickerModal Results="_pickerResults"
                      MediaType="@(_requestToRadarr ? "Movie" : "Series")"
                      OnSelected="OnPickerSelected" />
}

@code {
    [Parameter]
    public Anime Anime { get; set; } = default!;

    [Parameter] public bool Draggable { get; set; }
    [Parameter] public EventCallback<int> OnDragStarted { get; set; }
    [Parameter] public EventCallback OnDragEnded { get; set; }

    private bool _isRequesting;
    private (bool Ok, string Msg)? _requestResult;
    private bool _showPicker;
    private List<MediaLookupResult>? _pickerResults;
    private bool _inLibrary;
    private bool _requestToRadarr;

    private Task OnDragStart() => Draggable ? OnDragStarted.InvokeAsync(Anime.Id) : Task.CompletedTask;
    private Task OnDragEnd() => Draggable ? OnDragEnded.InvokeAsync() : Task.CompletedTask;

    protected override async Task OnParametersSetAsync()
    {
        await MediaLibraryService.EnsureRefreshedAsync();
        _inLibrary = MediaLibraryService.IsInSonarr(Anime)
                  || MediaLibraryService.IsInRadarr(Anime);
    }

    private async Task RequestAsync(bool? useRadarr = null)
    {
        _isRequesting = true;
        _requestResult = null;
        _requestToRadarr = useRadarr ?? Anime.Type == "Movie";
        try
        {
            var lookup = _requestToRadarr
                ? await MediaRequestService.LookupRadarrAsync(Anime.Title)
                : await MediaRequestService.LookupSonarrAsync(Anime.Title);

            if (!lookup.Ok || lookup.Results == null)
            {
                _requestResult = (false, lookup.Error);
                return;
            }

            _pickerResults = lookup.Results;
            _showPicker = true;
        }
        catch (Exception ex)
        {
            _requestResult = (false, ex.Message.Split('.')[0]);
        }
        finally
        {
            _isRequesting = false;
        }
    }

    private async Task OnPickerSelected(MediaLookupResult? selected)
    {
        _showPicker = false;
        _pickerResults = null;
        if (selected == null) return;

        _isRequesting = true;
        try
        {
            _requestResult = _requestToRadarr
                ? await MediaRequestService.AddToRadarrAsync(selected.RawData)
                : await MediaRequestService.AddToSonarrAsync(selected.RawData);
            if (_requestResult.Value.Ok)
            {
                MediaLibraryService.Invalidate();
                _inLibrary = true;
            }
        }
        catch (Exception ex)
        {
            _requestResult = (false, ex.Message.Split('.')[0]);
        }
        finally
        {
            _isRequesting = false;
        }
    }

    private string NormalizeStatus(string status)
    {
        return status.ToLower().Replace(" ", "-").Replace(":", "");
    }
}
