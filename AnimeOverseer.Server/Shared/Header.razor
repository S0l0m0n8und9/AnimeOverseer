@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavManager
@inject AnimeOverseer.Server.Services.CollectionService CollectionService
@inject AnimeOverseer.Server.Services.CollectionDragService CollectionDragService
@implements IDisposable
@rendermode InteractiveServer
<nav class="header-nav">
    <div class="nav-container">
        <a href="/" class="logo-link">
            <span class="logo-icon">&#x1F3AC;</span>
            <span class="logo-text">AnimeOverseer</span>
        </a>
        <form class="header-search" @onsubmit="SubmitSearch" @onsubmit:preventDefault>
            <span class="header-search-icon" aria-hidden="true">&#x1F50D;</span>
            <input type="search" @bind="searchQuery" @bind:event="oninput" placeholder="Search anime..." aria-label="Search anime" />
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <button type="button" class="header-search-clear" @onclick="ClearSearch" aria-label="Clear search">&#x2715;</button>
            }
            <button type="submit" class="header-search-submit">Search</button>
        </form>
        <div class="nav-links">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link active">
                <span class="nav-icon">&#x1F3E0;</span> Dashboard
            </NavLink>
            <div class="collections-nav-drop" @ondragenter="OpenCollectionDropAsync" @ondragover:preventDefault @ondrop="() => DropIntoCollectionAsync()">
                <NavLink href="/collections" class="nav-link">
                    <span class="nav-icon">&#x1F4C1;</span> Collections
                </NavLink>
                @if (showCollectionDrop)
                {
                    <div class="collections-nav-menu" @ondragover:preventDefault>
                        @if (manualCollections.Count == 0)
                        {
                            <span>No manual collections yet</span>
                        }
                        else
                        {
                            @foreach (var collection in manualCollections)
                            {
                                <button @ondragover:preventDefault @ondrop="() => DropIntoCollectionAsync(collection.Id)">Add to @collection.Name</button>
                            }
                        }
                    </div>
                }
            </div>
            <NavLink href="/settings" class="nav-link">
                <span class="nav-icon">&#x2699;&#xFE0F;</span> Settings
            </NavLink>
        </div>
    </div>
</nav>

@code {
    private string searchQuery = string.Empty;
    private bool showCollectionDrop;
    private List<AnimeOverseer.Server.Models.AnimeCollection> manualCollections = [];

    protected override void OnInitialized()
    {
        SyncSearchQuery(NavManager.Uri);
        NavManager.LocationChanged += OnLocationChanged;
        CollectionDragService.Changed += OnDragStateChanged;
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        CollectionDragService.Changed -= OnDragStateChanged;
    }

    private void SubmitSearch()
    {
        NavigateWithSearch(searchQuery);
    }

    private void ClearSearch()
    {
        searchQuery = string.Empty;
        NavigateWithSearch(null);
    }

    private void NavigateWithSearch(string? query)
    {
        var destination = string.IsNullOrWhiteSpace(query)
            ? "/"
            : "/?q=" + Uri.EscapeDataString(query.Trim());
        NavManager.NavigateTo(destination);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncSearchQuery(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OpenCollectionDropAsync()
    {
        if (CollectionDragService.AnimeId is null) return;
        manualCollections = (await CollectionService.GetAllAsync()).Where(collection => collection.Type == AnimeOverseer.Server.Models.CollectionType.Manual).ToList();
        showCollectionDrop = true;
    }

    private void OnDragStateChanged()
    {
        if (CollectionDragService.AnimeId is not null) return;
        showCollectionDrop = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task DropIntoCollectionAsync(int? collectionId = null)
    {
        if (collectionId is int id && CollectionDragService.AnimeId is int animeId)
            await CollectionService.AddAnimeAsync(id, animeId);
        CollectionDragService.Clear();
        showCollectionDrop = false;
    }

    private void SyncSearchQuery(string location)
    {
        var query = NavManager.ToAbsoluteUri(location).Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .FirstOrDefault(part => part.Length == 2 && part[0].Equals("q", StringComparison.OrdinalIgnoreCase));

        searchQuery = query is null ? string.Empty : Uri.UnescapeDataString(query[1]);
    }
}
