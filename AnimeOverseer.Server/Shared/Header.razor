@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject NavigationManager NavManager
@inject IJSRuntime JS
<nav class="header-nav">
    <div class="nav-container">
        <a href="/" class="logo-link">
            <span class="logo-icon">&#x1F3AC;</span>
            <span class="logo-text">AnimeOverseer</span>
        </a>
        <div class="nav-links">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link active">
                <span class="nav-icon">&#x1F3E0;</span> Dashboard
            </NavLink>
            <button class="nav-link" @onclick="NavigateToSearch">
                <span class="nav-icon">&#x1F50D;</span> Search
            </button>
        </div>
    </div>
</nav>

@code {
    private async Task NavigateToSearch()
    {
        NavManager.NavigateTo("/");
        await JS.InvokeVoidAsync("eval", "document.getElementById('search-input')?.focus(); window.scrollTo(0, 0);");
    }
}
