@page "/"
@rendermode InteractiveServer
@using AnimeOverseer.Server.Models
@using AnimeOverseer.Server.Services
@using System.Text.Json
@inject IAnimeDataSource AnimeDataSource
@inject NavigationManager NavManager
@inject MediaLibraryService MediaLibraryService
@implements IDisposable

<PageTitle>AnimeOverseer - Dashboard</PageTitle>

<div class="dashboard">
    <div class="controls-bar">
        <div class="preset-filters-row">
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetAllAnime">All Anime</button>
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetTopAiring">Top Airing</button>
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetTopUpcoming">Top Upcoming</button>
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetTopTVSeries">Top TV Series</button>
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetTopMovies">Top Movies</button>
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetTopOVAs">Top OVAs</button>
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetTopONAs">Top ONAs</button>
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetTopSpecials">Top Specials</button>
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetMostPopular">Most Popular</button>
            <button class="btn btn-outline-secondary me-2" @onclick="SetPresetMostFavorited">Most Favorited</button>
        </div>

        <div class="filters-row">
            <label class="filter-label" for="pagesize-select">Load:</label>
            <select id="pagesize-select" value="@pageSize" @onchange="OnPageSizeChanged" class="form-select" style="width:auto">
                <option value="12">12</option>
                <option value="24">24</option>
                <option value="48">48</option>
                <option value="96">96</option>
            </select>
            <span class="filter-label">at a time</span>
        </div>

        <div class="search-row">
            <div class="search-wrapper">
                <span class="search-icon">&#x1F50D;</span>
                <input type="text" id="search-input" placeholder="Search anime by title..." @bind="searchQuery"
                       @bind:event="oninput" @onkeydown="HandleKeyDown" class="form-input search-input" />
            </div>
        </div>

        <FilterBuilder State="filterState" OnChanged="OnFilterChanged"
            AvailableGenres="AvailableGenres"
            AvailableThemes="AvailableThemes"
            AvailableDemographics="AvailableDemographics" />
        <SortBuilder State="sortState" OnChanged="OnSortChanged" />
    </div>

    <div class="results-info">
        @if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            <span>@DisplayedAnimes.Count result@(DisplayedAnimes.Count != 1 ? "s" : "") for "@searchQuery"</span>
        }
        else if (filterState.IsActive)
        {
            <span>@DisplayedAnimes.Count of @allAnimes.Count anime@(allAnimes.Count != 1 ? "s" : "") shown (@totalCount total)</span>
        }
        else
        {
            <span>@allAnimes.Count of @totalCount anime@(totalCount != 1 ? "s" : "")</span>
        }
    </div>

    @if (isLoading && allAnimes.Count == 0)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Loading anime data...</p>
        </div>
    }
    else if (!isLoading && !isLoadingMore && DisplayedAnimes.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">&#x1F3AC;</span>
            <h3>No anime found</h3>
            <p>
                @if (filterState.IsActive && allAnimes.Count > 0)
                {
                    <text>No anime match the active filters. Try adjusting or clearing them.</text>
                }
                else if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <text>No results for "@searchQuery".</text>
                }
                else
                {
                    <text>No anime in the database yet.</text>
                }
            </p>
        </div>
    }
    else
    {
        <div class="anime-grid">
            @foreach (var anime in DisplayedAnimes)
            {
                <AnimeCard Anime="@anime" />
            }
        </div>
    }

    @if (string.IsNullOrWhiteSpace(searchQuery))
    {
        @if (isLoadingMore)
        {
            <div class="loading-container" style="padding:1rem 0">
                <div class="spinner"></div>
            </div>
        }
        else if (!isLoading && allAnimes.Count < totalCount)
        {
            <div style="display:flex;justify-content:center;padding:1.5rem 0">
                <button class="btn btn-primary" @onclick="LoadMore">
                    Load More (@(totalCount - allAnimes.Count) remaining)
                </button>
            </div>
        }
    }
</div>

@code {
    private List<Anime> allAnimes = new();
    private FilterState filterState = new();
    private SortState sortState = new();
    private int pageSize = 24;
    private int totalCount = 0;
    private string searchQuery = string.Empty;
    private bool isLoading = false;
    private bool isLoadingMore = false;
    private bool _ownNavigation = false;

    private List<Anime> DisplayedAnimes => SortEngine.Apply(
        filterState.IsActive && string.IsNullOrWhiteSpace(searchQuery) && !HasLibraryFilter
            ? allAnimes
            : FilterEngine.Apply(allAnimes, filterState, IsInLibrary),
        sortState, IsInLibrary);

    private bool HasLibraryFilter => filterState.Groups
        .SelectMany(g => g.Conditions)
        .Any(c => c.Field == FilterField.InLibrary && FilterState.IsActiveCondition(c));

    private bool IsInLibrary(Anime anime) =>
        MediaLibraryService.IsInSonarr(anime) || MediaLibraryService.IsInRadarr(anime);

    private List<string> AvailableGenres { get; set; } = [];
    private List<string> AvailableThemes { get; set; } = [];
    private List<string> AvailableDemographics { get; set; } = [];

    // ── Lifecycle ────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;
        await RestoreFromUrl(NavManager.Uri);
        await Task.WhenAll(LoadTagsAsync(), MediaLibraryService.EnsureRefreshedAsync());
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_ownNavigation) { _ownNavigation = false; return; }

        _ = InvokeAsync(async () =>
        {
            await RestoreFromUrl(e.Location);
            StateHasChanged();
        });
    }

    // ── URL ──────────────────────────────────────────────────

    private async Task RestoreFromUrl(string uri)
    {
        var qs = ParseQuery(uri);

        pageSize    = qs.TryGetValue("pageSize", out var ps) && int.TryParse(ps, out var psi) ? psi : 24;
        searchQuery = qs.GetValueOrDefault("q", string.Empty);
        filterState = qs.TryGetValue("filters", out var f)
            ? DeserializeFilters(f) ?? new FilterState()
            : new FilterState();
        sortState   = qs.TryGetValue("sort", out var s)
            ? DeserializeSort(s) ?? new SortState()
            : new SortState();

        allAnimes  = new();
        totalCount = 0;

        if (!string.IsNullOrWhiteSpace(searchQuery))
            await LoadSearch();
        else if (filterState.IsActive)
            await LoadFiltered();
        else
            await LoadRecent();
    }

    private void PushUrl(bool replace = false)
    {
        _ownNavigation = true;
        NavManager.NavigateTo(BuildUrl(), replace: replace);
    }

    private string BuildUrl()
    {
        var parts = new List<string>();
        if (pageSize != 24)
            parts.Add($"pageSize={pageSize}");
        if (!string.IsNullOrEmpty(searchQuery))
            parts.Add($"q={Uri.EscapeDataString(searchQuery)}");
        if (filterState.IsActive)
            parts.Add($"filters={Uri.EscapeDataString(SerializeFilters(filterState))}");
        if (sortState.IsActive)
            parts.Add($"sort={Uri.EscapeDataString(SerializeSort(sortState))}");
        return parts.Count == 0 ? "/" : "/?" + string.Join("&", parts);
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var idx = uri.IndexOf('?');
        if (idx < 0) return new(StringComparer.OrdinalIgnoreCase);

        return uri[(idx + 1)..]
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Split('=', 2))
            .Where(p => p.Length == 2)
            .ToDictionary(
                p => Uri.UnescapeDataString(p[0]),
                p => Uri.UnescapeDataString(p[1]),
                StringComparer.OrdinalIgnoreCase);
    }

    // ── Data loading ─────────────────────────────────────────

    private async Task LoadRecent(bool append = false)
    {
        if (append) isLoadingMore = true;
        else isLoading = true;
        StateHasChanged();
        try
        {
            var skip  = append ? allAnimes.Count : 0;
            var items = await AnimeDataSource.GetRecentAsync(skip, pageSize);
            if (!append) totalCount = await AnimeDataSource.GetTotalCountAsync();
            if (append) allAnimes.AddRange(items);
            else        allAnimes = items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching anime: {ex.Message}");
            if (!append) allAnimes = new();
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    private async Task LoadFiltered(bool append = false)
    {
        if (append) isLoadingMore = true;
        else isLoading = true;
        StateHasChanged();
        try
        {
            if (HasLibraryFilter)
            {
                if (append) return;

                var libraryFilterCandidates = await AnimeDataSource.GetFilteredAsync(new FilterState(), 0, int.MaxValue);
                allAnimes = FilterEngine.Apply(libraryFilterCandidates, filterState, IsInLibrary);
                totalCount = allAnimes.Count;
                return;
            }

            var skip  = append ? allAnimes.Count : 0;
            var items = await AnimeDataSource.GetFilteredAsync(filterState, skip, pageSize);
            if (!append) totalCount = await AnimeDataSource.GetFilteredCountAsync(filterState);
            if (append) allAnimes.AddRange(items);
            else        allAnimes = items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching filtered anime: {ex.Message}");
            if (!append) allAnimes = new();
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    private async Task LoadTagsAsync()
    {
        try
        {
            var genres  = AnimeDataSource.GetGenreNamesAsync();
            var themes  = AnimeDataSource.GetThemeNamesAsync();
            var demogs  = AnimeDataSource.GetDemographicNamesAsync();
            await Task.WhenAll(genres, themes, demogs);
            AvailableGenres       = genres.Result;
            AvailableThemes       = themes.Result;
            AvailableDemographics = demogs.Result;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tags: {ex.Message}");
        }
    }

    private async Task LoadSearch()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            allAnimes  = await AnimeDataSource.SearchAsync(searchQuery);
            totalCount = allAnimes.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching: {ex.Message}");
            allAnimes = new();
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task LoadMostFavorited(bool append = false)
    {
        if (append) isLoadingMore = true;
        else isLoading = true;
        StateHasChanged();
        try
        {
            var skip  = append ? allAnimes.Count : 0;
            var items = await AnimeDataSource.GetMostFavoritedAsync(skip, pageSize);
            if (!append) totalCount = await AnimeDataSource.GetTotalCountAsync(); // Note: This might not be accurate for most favorited
            if (append) allAnimes.AddRange(items);
            else        allAnimes = items;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading most favorited anime: {ex.Message}");
            if (!append) allAnimes = new();
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            StateHasChanged();
        }
    }

    // ── User actions ─────────────────────────────────────────

    private async Task LoadMore()
    {
        if (filterState.IsActive && string.IsNullOrWhiteSpace(searchQuery))
            await LoadFiltered(append: true);
        else
            await LoadRecent(append: true);
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size) || size == pageSize) return;
        pageSize   = size;
        allAnimes  = new();
        totalCount = 0;
        PushUrl(replace: true);
        if (filterState.IsActive)
            await LoadFiltered();
        else
            await LoadRecent();
    }

    private async Task SearchAnime()
    {
        allAnimes  = new();
        totalCount = 0;
        PushUrl(replace: false);
        if (!string.IsNullOrWhiteSpace(searchQuery))
            await LoadSearch();
        else if (filterState.IsActive)
            await LoadFiltered();
        else
            await LoadRecent();
    }

    private async Task OnFilterChanged()
    {
        allAnimes  = new();
        totalCount = 0;
        PushUrl(replace: true);
        if (filterState.IsActive)
            await LoadFiltered();
        else
            await LoadRecent();
    }

    private void OnSortChanged()
    {
        PushUrl(replace: true);
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SearchAnime();
    }

    // ── Preset Filter Handlers ──────────────────────────────────────
    private async Task SetPresetAllAnime()
    {
        filterState = new FilterState();
        sortState = new SortState();
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadRecent();
    }

    private async Task SetPresetTopAiring()
    {
        filterState = new FilterState
        {
            Groups = [new FilterGroup
            {
                Conditions = [new FilterCondition
                {
                    Field = FilterField.Status,
                    Operator = FilterOperator.Equals,
                    Value = "Currently Airing"
                }]
            }]
        };
        sortState = new SortState();
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadFiltered();
    }

    private async Task SetPresetTopUpcoming()
    {
        filterState = new FilterState
        {
            Groups = [new FilterGroup
            {
                Conditions = [new FilterCondition
                {
                    Field = FilterField.Status,
                    Operator = FilterOperator.Equals,
                    Value = "Not Yet Aired"
                }]
            }]
        };
        sortState = new SortState();
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadFiltered();
    }

    private async Task SetPresetTopTVSeries()
    {
        filterState = new FilterState
        {
            Groups = [new FilterGroup
            {
                Conditions = [new FilterCondition
                {
                    Field = FilterField.Type,
                    Operator = FilterOperator.Equals,
                    Value = "TV"
                }]
            }]
        };
        sortState = new SortState();
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadFiltered();
    }

    private async Task SetPresetTopMovies()
    {
        filterState = new FilterState
        {
            Groups = [new FilterGroup
            {
                Conditions = [new FilterCondition
                {
                    Field = FilterField.Type,
                    Operator = FilterOperator.Equals,
                    Value = "Movie"
                }]
            }]
        };
        sortState = new SortState();
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadFiltered();
    }

    private async Task SetPresetTopOVAs()
    {
        filterState = new FilterState
        {
            Groups = [new FilterGroup
            {
                Conditions = [new FilterCondition
                {
                    Field = FilterField.Type,
                    Operator = FilterOperator.Equals,
                    Value = "OVA"
                }]
            }]
        };
        sortState = new SortState();
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadFiltered();
    }

    private async Task SetPresetTopONAs()
    {
        filterState = new FilterState
        {
            Groups = [new FilterGroup
            {
                Conditions = [new FilterCondition
                {
                    Field = FilterField.Type,
                    Operator = FilterOperator.Equals,
                    Value = "ONA"
                }]
            }]
        };
        sortState = new SortState();
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadFiltered();
    }

    private async Task SetPresetTopSpecials()
    {
        filterState = new FilterState
        {
            Groups = [new FilterGroup
            {
                Conditions = [new FilterCondition
                {
                    Field = FilterField.Type,
                    Operator = FilterOperator.Equals,
                    Value = "Special"
                }]
            }]
        };
        sortState = new SortState();
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadFiltered();
    }

    private async Task SetPresetMostPopular()
    {
        filterState = new FilterState();
        sortState = new SortState
        {
            Criteria = [new SortCriterion
            {
                Field = SortField.Rating,
                Direction = SortDirection.Descending
            }]
        };
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadRecent(); // LoadRecent respects sortState
    }

    private async Task SetPresetMostFavorited()
    {
        // For Most Favorited, we'll load anime sorted by request count
        // This requires a special query since we don't have built-in sorting by Requests count
        filterState = new FilterState();
        sortState = new SortState(); // Clear sort since we're using custom loading
        searchQuery = string.Empty;
        allAnimes = new();
        totalCount = 0;
        PushUrl(replace: true);
        await LoadMostFavorited();
    }

    // ── Serialisation ────────────────────────────────────────

    private static string SerializeFilters(FilterState state)
    {
        var dto = new
        {
            l = (int)state.TopLevelLogic,
            g = state.Groups
                .Select(g => new
                {
                    l = (int)g.Logic,
                    c = g.Conditions
                        .Where(c => !string.IsNullOrEmpty(c.Value))
                        .Select(c => new { f = (int)c.Field, o = (int)c.Operator, v = c.Value })
                        .ToArray()
                })
                .Where(g => g.c.Length > 0)
                .ToArray()
        };
        return JsonSerializer.Serialize(dto);
    }

    private static string SerializeSort(SortState state)
    {
        var dto = state.Criteria
            .Select(c => new { f = (int)c.Field, d = (int)c.Direction })
            .ToArray();
        return JsonSerializer.Serialize(dto);
    }

    private static SortState? DeserializeSort(string encoded)
    {
        try
        {
            using var doc = JsonDocument.Parse(encoded);
            return new SortState
            {
                Criteria = doc.RootElement.EnumerateArray().Select(c => new SortCriterion
                {
                    Field     = (SortField)c.GetProperty("f").GetInt32(),
                    Direction = (SortDirection)c.GetProperty("d").GetInt32()
                }).ToList()
            };
        }
        catch { return null; }
    }

    private static FilterState? DeserializeFilters(string encoded)
    {
        try
        {
            using var doc = JsonDocument.Parse(encoded);
            var root  = doc.RootElement;
            var state = new FilterState
            {
                TopLevelLogic = (GroupLogic)root.GetProperty("l").GetInt32(),
                Groups = root.GetProperty("g").EnumerateArray().Select(g => new FilterGroup
                {
                    Logic = (GroupLogic)g.GetProperty("l").GetInt32(),
                    Conditions = g.GetProperty("c").EnumerateArray().Select(c => new FilterCondition
                    {
                        Field    = (FilterField)c.GetProperty("f").GetInt32(),
                        Operator = (FilterOperator)c.GetProperty("o").GetInt32(),
                        Value    = c.GetProperty("v").GetString() ?? string.Empty
                    }).ToList()
                }).ToList()
            };
            if (state.Groups.Count == 0) state.Groups.Add(new FilterGroup());
            return state;
        }
        catch { return null; }
    }
}
