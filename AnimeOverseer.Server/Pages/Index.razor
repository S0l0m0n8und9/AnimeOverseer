@page "/"
@rendermode InteractiveServer
@using AnimeOverseer.Server.Models
@using AnimeOverseer.Server.Services
@inject IAnimeDataSource AnimeDataSource
@inject NavigationManager NavManager

<PageTitle>AnimeOverseer - Dashboard</PageTitle>

<div class="dashboard">
    <div class="controls-bar">
        <div class="filters-row">
            <label class="filter-label" for="season-select">Season:</label>
            <select id="season-select" @bind="selectedSeason" @bind:event="oninput" class="form-select">
                <option value="spring">Spring</option>
                <option value="summer">Summer</option>
                <option value="fall">Fall</option>
                <option value="winter">Winter</option>
            </select>

            <label class="filter-label" for="year-select">Year:</label>
            <select id="year-select" @bind="selectedYear" @bind:event="oninput" class="form-select">
                @for (int y = 2030; y >= 2000; y--)
                {
                    <option value="@y">@y</option>
                }
            </select>

            <button class="btn btn-primary" @onclick="FetchSeasonAnimes" disabled="@isLoading">
                <span class="btn-icon">&#x1F50D;</span> Search Season
            </button>

            <button class="btn btn-secondary" @onclick="RefreshFromWeb" disabled="@isLoading" title="Bypass cache and fetch fresh data from the web">
                <span class="btn-icon">&#x1F504;</span> Refresh from Web
            </button>
        </div>

        <div class="search-row">
            <div class="search-wrapper">
                <span class="search-icon">&#x1F50D;</span>
                <input type="text" id="search-input" placeholder="Search anime by title..." @bind="searchQuery" @bind:event="oninput" @onkeydown="HandleKeyDown" class="form-input search-input" />
            </div>
        </div>

        <FilterBuilder State="filterState" OnChanged="OnFilterChanged" />
    </div>

    <div class="results-info">
        @if (filterState.IsActive)
        {
            <span>@DisplayedAnimes.Count of @allAnimes.Count anime@(allAnimes.Count != 1 ? "s" : "") shown</span>
        }
        else
        {
            <span>@allAnimes.Count anime@(allAnimes.Count != 1 ? "s" : "") found</span>
        }
        @if (searchQuery.Length > 0)
        {
            <span class="search-hint">Showing results for "@searchQuery"</span>
        }
        @if (isRefreshing)
        {
            <span class="search-hint">Refreshing from web...</span>
        }
    </div>

    @if (isLoading && allAnimes.Count == 0)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>@(isRefreshing ? "Fetching fresh data from the web..." : "Loading anime data...")</p>
        </div>
    }
    else if (!isLoading && DisplayedAnimes.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">&#x1F3AC;</span>
            <h3>No anime found</h3>
            <p>
                @if (filterState.IsActive && allAnimes.Count > 0)
                {
                    <text>No anime match the active filters. Try adjusting or clearing them.</text>
                }
                else
                {
                    <text>Try selecting a different season or year, or search for an anime title.</text>
                }
            </p>
        </div>
    }
    else
    {
        <div class="anime-grid">
            @foreach (var anime in DisplayedAnimes)
            {
                <AnimeCard Anime="@anime" />
            }
        </div>
    }
</div>

@code {
    private List<Anime> allAnimes = new();
    private FilterState filterState = new();
    private string selectedSeason = "spring";
    private int selectedYear = 2025;
    private string searchQuery = string.Empty;
    private bool isLoading = false;
    private bool isRefreshing = false;

    private List<Anime> DisplayedAnimes => FilterEngine.Apply(allAnimes, filterState);

    protected override async Task OnInitializedAsync()
    {
        await FetchSeasonAnimes();
    }

    private void OnFilterChanged() => StateHasChanged();

    private async Task FetchSeasonAnimes()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            allAnimes = await AnimeDataSource.GetSeasonAnimes(selectedYear, selectedSeason);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching season anime: {ex.Message}");
            allAnimes = new List<Anime>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshFromWeb()
    {
        isLoading = true;
        isRefreshing = true;
        StateHasChanged();
        try
        {
            allAnimes = await AnimeDataSource.GetSeasonAnimes(selectedYear, selectedSeason, forceRefresh: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing anime: {ex.Message}");
            allAnimes = new List<Anime>();
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task SearchAnime()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            await FetchSeasonAnimes();
            return;
        }

        isLoading = true;
        StateHasChanged();
        try
        {
            allAnimes = await AnimeDataSource.SearchAsync(searchQuery);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching anime: {ex.Message}");
            allAnimes = new List<Anime>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchAnime();
    }
}
