@page "/"
@rendermode InteractiveServer
@using AnimeOverseer.Server.Models
@using AnimeOverseer.Server.Services
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IAnimeDataSource AnimeDataSource
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>AnimeOverseer - Dashboard</PageTitle>

<div class="dashboard">
    <div class="controls-bar">
        <div class="filters-row">
            <label class="filter-label" for="season-select">Season:</label>
            <select id="season-select" @bind="selectedSeason" @bind:event="oninput" class="form-select">
                <option value="spring">Spring</option>
                <option value="summer">Summer</option>
                <option value="fall">Fall</option>
                <option value="winter">Winter</option>
            </select>

            <label class="filter-label" for="year-select">Year:</label>
            <select id="year-select" @bind="selectedYear" @bind:event="oninput" class="form-select">
                @for (int y = 2030; y >= 2000; y--)
                {
                    <option value="@y">@y</option>
                }
            </select>

            <button class="btn btn-primary" @onclick="FetchSeasonAnimes" disabled="@isLoading">
                <span class="btn-icon">&#x1F50D;</span> Search Season
            </button>

            <button class="btn btn-secondary" @onclick="RefreshFromWeb" disabled="@isLoading" title="Bypass cache and fetch fresh data from the web">
                <span class="btn-icon">&#x1F504;</span> Refresh from Web
            </button>
        </div>

        <div class="search-row">
            <div class="search-wrapper">
                <span class="search-icon">&#x1F50D;</span>
                <input type="text" id="search-input" placeholder="Search anime by title..." @bind="searchQuery"
                       @bind:event="oninput" @onkeydown="HandleKeyDown" class="form-input search-input" />
            </div>
        </div>

        <FilterBuilder State="filterState" OnChanged="OnFilterChanged" AvailableGenres="AvailableGenres" />
        <SortBuilder State="sortState" OnChanged="OnSortChanged" />
    </div>

    <div class="results-info">
        @if (filterState.IsActive)
        {
            <span>@DisplayedAnimes.Count of @allAnimes.Count anime@(allAnimes.Count != 1 ? "s" : "") shown</span>
        }
        else
        {
            <span>@allAnimes.Count anime@(allAnimes.Count != 1 ? "s" : "") found</span>
        }
        @if (!string.IsNullOrEmpty(searchQuery))
        {
            <span class="search-hint">Showing results for "@searchQuery"</span>
        }
        @if (isRefreshing)
        {
            <span class="search-hint">Refreshing from web...</span>
        }
    </div>

    @if (isLoading && allAnimes.Count == 0)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>@(isRefreshing ? "Fetching fresh data from the web..." : "Loading anime data...")</p>
        </div>
    }
    else if (!isLoading && DisplayedAnimes.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">&#x1F3AC;</span>
            <h3>No anime found</h3>
            <p>
                @if (filterState.IsActive && allAnimes.Count > 0)
                {
                    <text>No anime match the active filters. Try adjusting or clearing them.</text>
                }
                else
                {
                    <text>Try selecting a different season or year, or search for an anime title.</text>
                }
            </p>
        </div>
    }
    else
    {
        <div class="anime-grid">
            @foreach (var anime in DisplayedAnimes)
            {
                <AnimeCard Anime="@anime" />
            }
        </div>
    }
</div>

@code {
    private List<Anime> allAnimes = new();
    private FilterState filterState = new();
    private SortState sortState = new();
    private string selectedSeason = CurrentAnimeSeason();
    private int selectedYear = CurrentAnimeYear();

    // Anime seasons follow Japan (Northern Hemisphere) regardless of server locale.
    private static string CurrentAnimeSeason() => DateTime.UtcNow.Month switch
    {
        1 or 2 or 3   => "winter",
        4 or 5 or 6   => "spring",
        7 or 8 or 9   => "summer",
        _             => "fall"
    };

    private static int CurrentAnimeYear() => DateTime.UtcNow.Year;
    private string searchQuery = string.Empty;
    private bool isLoading = false;
    private bool isRefreshing = false;
    private bool _ownNavigation = false;

    private List<Anime> DisplayedAnimes => SortEngine.Apply(FilterEngine.Apply(allAnimes, filterState), sortState);

    private List<string> AvailableGenres => allAnimes
        .SelectMany(a => a.AnimeGenres.Select(ag => ag.Genre?.Name ?? ""))
        .Where(n => !string.IsNullOrEmpty(n))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(n => n)
        .ToList();

    // ── Lifecycle ────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;
        await RestoreFromUrl(NavManager.Uri);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }

    // Fires on browser back/forward and on any NavigateTo call.
    // Skip if WE initiated the navigation.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_ownNavigation) { _ownNavigation = false; return; }

        _ = InvokeAsync(async () =>
        {
            await RestoreFromUrl(e.Location);
            StateHasChanged();
        });
    }

    // ── URL ──────────────────────────────────────────────────

    // Parses URL, updates all state fields, then loads data.
    // Never calls PushUrl — URL is already correct when this runs.
    private async Task RestoreFromUrl(string uri)
    {
        var qs = ParseQuery(uri);

        selectedSeason = qs.GetValueOrDefault("season", CurrentAnimeSeason());
        selectedYear   = qs.TryGetValue("year", out var y) && int.TryParse(y, out var yi) ? yi : CurrentAnimeYear();
        searchQuery    = qs.GetValueOrDefault("q", string.Empty);
        filterState    = qs.TryGetValue("filters", out var f)
            ? DeserializeFilters(f) ?? new FilterState()
            : new FilterState();
        sortState      = qs.TryGetValue("sort", out var s)
            ? DeserializeSort(s) ?? new SortState()
            : new SortState();

        if (!string.IsNullOrWhiteSpace(searchQuery))
            await LoadSearch();
        else
            await LoadSeason();
    }

    // Push a new history entry (Search Season / text search).
    // Use replace:true for in-place updates (filter changes, refresh).
    private void PushUrl(bool replace = false)
    {
        _ownNavigation = true;
        NavManager.NavigateTo(BuildUrl(), replace: replace);
    }

    private string BuildUrl()
    {
        var parts = new List<string>
        {
            $"season={Uri.EscapeDataString(selectedSeason)}",
            $"year={selectedYear}"
        };
        if (!string.IsNullOrEmpty(searchQuery))
            parts.Add($"q={Uri.EscapeDataString(searchQuery)}");
        if (filterState.IsActive)
            parts.Add($"filters={Uri.EscapeDataString(SerializeFilters(filterState))}");
        if (sortState.IsActive)
            parts.Add($"sort={Uri.EscapeDataString(SerializeSort(sortState))}");

        return "/?" + string.Join("&", parts);
    }

    private static Dictionary<string, string> ParseQuery(string uri)
    {
        var idx = uri.IndexOf('?');
        if (idx < 0) return new(StringComparer.OrdinalIgnoreCase);

        return uri[(idx + 1)..]
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Split('=', 2))
            .Where(p => p.Length == 2)
            .ToDictionary(
                p => Uri.UnescapeDataString(p[0]),
                p => Uri.UnescapeDataString(p[1]),
                StringComparer.OrdinalIgnoreCase);
    }

    // Compact serialisation — omits GUIDs, only stores meaningful values.
    private static string SerializeFilters(FilterState state)
    {
        var dto = new
        {
            l = (int)state.TopLevelLogic,
            g = state.Groups
                .Select(g => new
                {
                    l = (int)g.Logic,
                    c = g.Conditions
                        .Where(c => !string.IsNullOrEmpty(c.Value))
                        .Select(c => new { f = (int)c.Field, o = (int)c.Operator, v = c.Value })
                        .ToArray()
                })
                .Where(g => g.c.Length > 0)
                .ToArray()
        };
        return JsonSerializer.Serialize(dto);
    }

    private static string SerializeSort(SortState state)
    {
        var dto = state.Criteria
            .Select(c => new { f = (int)c.Field, d = (int)c.Direction })
            .ToArray();
        return JsonSerializer.Serialize(dto);
    }

    private static SortState? DeserializeSort(string encoded)
    {
        try
        {
            using var doc = JsonDocument.Parse(encoded);
            var state = new SortState
            {
                Criteria = doc.RootElement.EnumerateArray().Select(c => new SortCriterion
                {
                    Field     = (SortField)c.GetProperty("f").GetInt32(),
                    Direction = (SortDirection)c.GetProperty("d").GetInt32()
                }).ToList()
            };
            return state;
        }
        catch { return null; }
    }

    private static FilterState? DeserializeFilters(string encoded)
    {
        try
        {
            using var doc = JsonDocument.Parse(encoded);
            var root = doc.RootElement;
            var state = new FilterState
            {
                TopLevelLogic = (GroupLogic)root.GetProperty("l").GetInt32(),
                Groups = root.GetProperty("g").EnumerateArray().Select(g => new FilterGroup
                {
                    Logic = (GroupLogic)g.GetProperty("l").GetInt32(),
                    Conditions = g.GetProperty("c").EnumerateArray().Select(c => new FilterCondition
                    {
                        Field    = (FilterField)c.GetProperty("f").GetInt32(),
                        Operator = (FilterOperator)c.GetProperty("o").GetInt32(),
                        Value    = c.GetProperty("v").GetString() ?? string.Empty
                    }).ToList()
                }).ToList()
            };
            if (state.Groups.Count == 0) state.Groups.Add(new FilterGroup());
            return state;
        }
        catch { return null; }
    }

    // ── Data loading (no URL side-effects — safe to call from RestoreFromUrl) ──

    private async Task LoadSeason(bool forceRefresh = false)
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            allAnimes = await AnimeDataSource.GetSeasonAnimes(selectedYear, selectedSeason, forceRefresh);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching season anime: {ex.Message}");
            allAnimes = new();
        }
        finally { isLoading = false; isRefreshing = false; StateHasChanged(); }
    }

    private async Task LoadSearch()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            allAnimes = await AnimeDataSource.SearchAsync(searchQuery);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching: {ex.Message}");
            allAnimes = new();
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    // ── User actions (push URL then load) ────────────────────

    private async Task FetchSeasonAnimes()
    {
        searchQuery = string.Empty;
        PushUrl(replace: false);
        await LoadSeason();
    }

    private async Task RefreshFromWeb()
    {
        isRefreshing = true;
        PushUrl(replace: true);
        await LoadSeason(forceRefresh: true);
    }

    private async Task SearchAnime()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            await FetchSeasonAnimes();
            return;
        }
        PushUrl(replace: false);
        await LoadSearch();
    }

    private void OnFilterChanged()
    {
        PushUrl(replace: true);
        StateHasChanged();
    }

    private void OnSortChanged()
    {
        PushUrl(replace: true);
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SearchAnime();
    }
}
