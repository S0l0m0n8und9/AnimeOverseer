@page "/anime/{id:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AnimeOverseer.Server.Models
@using AnimeOverseer.Server.Services
@using System.Text.Json.Nodes
@inject IAnimeDataSource AnimeDataSource
@inject NavigationManager NavManager
@inject MediaRequestService MediaRequestService
@inject MediaLibraryService MediaLibraryService
@inject AnimeReviewService AnimeReviewService

<PageTitle>@(anime?.Title ?? "Loading...") - AnimeOverseer</PageTitle>

<div class="detail-page">
    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Loading anime details...</p>
        </div>
    }
    else if (anime != null)
    {
        <div class="detail-actions">
            <button class="btn btn-back" @onclick="goBack">
                <span>&#x2190;</span> Back to Dashboard
            </button>
            <button class="btn btn-refresh" @onclick="RefreshAsync" disabled="@isRefreshing">
                @if (isRefreshing)
                {
                    <span class="spinner-small"></span>
                    <span>Refreshing...</span>
                }
                else
                {
                    <span>&#x21BB;</span>
                    <span>Refresh</span>
                }
            </button>
            @if (!_inLibrary)
            {
                @if (anime.Type == "TV" || anime.Type == "Movie")
                {
                    <button class="btn btn-request" @onclick="() => RequestAsync()" disabled="@_isRequesting">
                        @if (_isRequesting)
                        {
                            <span class="spinner-small"></span>
                            <span>Requesting...</span>
                        }
                        else
                        {
                            <span>+ Request in @(anime.Type == "Movie" ? "Radarr" : "Sonarr")</span>
                        }
                    </button>
                }
                else
                {
                    <button class="btn btn-request" @onclick="() => RequestAsync(useRadarr: false)" disabled="@_isRequesting">+ Request in Sonarr</button>
                    <button class="btn btn-request" @onclick="() => RequestAsync(useRadarr: true)" disabled="@_isRequesting">+ Request in Radarr</button>
                }
            }
            @if (_inLibrary)
            {
                <span class="in-library-badge">&#x2713; In Library</span>
            }
            @if (_requestResult.HasValue)
            {
                <span class="request-result @(_requestResult.Value.Ok ? "result-ok" : "result-error")">
                    @(_requestResult.Value.Ok ? "✓" : "✗") @_requestResult.Value.Msg
                </span>
            }
        </div>

        <div class="detail-card">
            <div class="detail-header">
                <div class="cover-wrapper">
                    @if (!string.IsNullOrEmpty(anime.DisplayLocalImagePath) || !string.IsNullOrEmpty(anime.DisplayImageUrl))
                    {
                        <img src="@(anime.DisplayLocalImagePath ?? anime.DisplayImageUrl)" alt="@anime.Title cover" class="cover-image" onerror="this.src='/images/placeholder.png'" />
                    }
                    else
                    {
                        <div class="cover-placeholder">
                            <span>&#x1F3AC;</span>
                        </div>
                    }
                </div>

                <div class="detail-info">
                    <h1 class="detail-title">@anime.Title</h1>
                    @if (!string.IsNullOrEmpty(anime.OriginalTitle))
                    {
                        <p class="original-title">@anime.OriginalTitle</p>
                    }
                    @if (DisplayAliases.Count > 0)
                    {
                        <details class="title-aliases">
                            <summary>Also known as (@DisplayAliases.Count)</summary>
                            <ul>
                                @foreach (var alias in DisplayAliases)
                                {
                                    <li><span>@alias</span><button class="alias-use-button" @onclick="() => SetMainEnglishTitleAsync(alias)">Use as main English name</button></li>
                                }
                            </ul>
                        </details>
                    }
                    <div class="custom-title-editor">
                        <input @bind="_customEnglishTitle" placeholder="Custom English name" aria-label="Custom English name" />
                        <button @onclick="SetCustomEnglishTitleAsync" disabled="@string.IsNullOrWhiteSpace(_customEnglishTitle)">Use as main English name</button>
                    </div>

                    <div class="meta-badges">
                        @if (!string.IsNullOrEmpty(anime.Type))
                        {
                            <span class="badge badge-type">@anime.Type</span>
                        }
                        @if (anime.Episodes.HasValue)
                        {
                            <span class="badge badge-episodes">@anime.Episodes.Value Episodes</span>
                        }
                        @if (!string.IsNullOrEmpty(anime.Status))
                        {
                            <span class="badge badge-status status-@(NormalizeStatus(anime.Status))">@anime.Status</span>
                        }
                    </div>

                    @if (anime.AnimeGenres.Count > 0)
                    {
                        <div class="genre-badges">
                            @foreach (var ag in anime.AnimeGenres)
                            {
                                <span class="badge badge-genre">@ag.Genre.Name</span>
                            }
                        </div>
                    }

                    @if (anime.AnimeThemes.Count > 0)
                    {
                        <div class="genre-badges">
                            @foreach (var at in anime.AnimeThemes)
                            {
                                <span class="badge badge-theme">@at.Theme.Name</span>
                            }
                        </div>
                    }

                    @if (anime.AnimeDemographics.Count > 0)
                    {
                        <div class="genre-badges">
                            @foreach (var ad in anime.AnimeDemographics)
                            {
                                <span class="badge badge-demographic">@ad.Demographic.Name</span>
                            }
                        </div>
                    }

                    <div class="rating-section">
                        @if (anime.Rating.HasValue)
                        {
                            <div class="rating-display">
                                <span class="rating-score">@anime.Rating.Value.ToString("F1")</span>
                                <span class="rating-max">/ 10</span>
                                <div class="stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        var filled = anime.Rating.Value >= i * 2;
                                        var half = !filled && anime.Rating.Value >= (i - 1) * 2 + 1;
                                        <span class="star @(filled ? "filled" : half ? "half" : "")">&#9733;</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (anime.StartDate.HasValue)
                    {
                        <div class="dates-section">
                            <span><strong>Started:</strong> @anime.StartDate.Value.ToString("MMM dd, yyyy")</span>
                            @if (anime.EndDate.HasValue)
                            {
                                <span><strong>Ended:</strong> @anime.EndDate.Value.ToString("MMM dd, yyyy")</span>
                            }
                        </div>
                    }

                    @if (anime.MALId is > 0 || anime.AniListId is > 0 || anime.KitsuId is > 0)
                    {
                        <div class="external-links">
                            @if (anime.MALId is > 0)
                            {
                                <a href="https://myanimelist.net/anime/@anime.MALId" target="_blank" rel="noopener noreferrer" class="external-link mal">MyAnimeList</a>
                            }
                            @if (anime.AniListId is > 0)
                            {
                                <a href="https://anilist.co/anime/@anime.AniListId" target="_blank" rel="noopener noreferrer" class="external-link anilist">AniList</a>
                            }
                            @if (anime.KitsuId is > 0)
                            {
                                <a href="https://kitsu.io/anime/@anime.KitsuId" target="_blank" rel="noopener noreferrer" class="external-link kitsu">Kitsu</a>
                            }
                        </div>
                    }

                    @if (anime.Season != null && anime.Season.Year > 0)
                    {
                        <div class="season-nav">
                            <span class="season-nav-label">@anime.Season.Year:</span>
                            @foreach (var s in new[] { "spring", "summer", "fall", "winter" })
                            {
                                var isCurrent = string.Equals(s, anime.Season.Name, StringComparison.OrdinalIgnoreCase);
                                <a href="/?season=@s&year=@anime.Season.Year"
                                   class="season-nav-link @(isCurrent ? "active" : "")">
                                    @(char.ToUpper(s[0]) + s[1..])
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (GalleryImages.Count > 0)
            {
                <details class="detail-collapsible artwork-gallery">
                    <summary>Artwork (@GalleryImages.Count)</summary>
                    <div class="detail-collapsible-content">
                    <div class="artwork-gallery-heading">
                        <div>
                            <p>Choose an image to preview it, then make it the main poster.</p>
                        </div>
                        <div class="artwork-gallery-actions">
                            <button class="btn btn-secondary" @onclick="ExpandPreview" disabled="@(CurrentImage is null)">Expand preview</button>
                            <button class="btn btn-secondary" @onclick="SetCurrentImageAsPosterAsync" disabled="@(CurrentImage is null || CurrentImage.Id == anime.PreferredImageId || _isSettingPoster)">
                                @(_isSettingPoster ? "Saving..." : CurrentImage?.Id == anime.PreferredImageId ? "Main poster" : "Set as main poster")
                            </button>
                        </div>
                    </div>

                    @if (_quickFilterRankings.Count > 0)
                    {
                        <div class="genre-badges" aria-label="Quick-filter rankings">
                            @foreach (var ranking in _quickFilterRankings)
                            {
                                <a class="badge badge-type" href="/?preset=@ranking.Preset" title="View @ranking.Label">@ranking.Label #@ranking.Rank</a>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_posterMessage))
                    {
                        <p class="artwork-gallery-message">@_posterMessage</p>
                    }
                    @if (CurrentImage is not null)
                    {
                        <div class="artwork-preview">
                            <img src="@(CurrentImage.LocalImagePath ?? CurrentImage.ImageUrl)" alt="Selected @anime.Title @CurrentImage.Type artwork" onerror="this.style.display='none'" />
                        </div>
                    }
                    <div class="artwork-gallery-thumbnails" role="list" aria-label="Anime artwork">
                        @foreach (var image in GalleryImages)
                        {
                            <button class="artwork-thumbnail @(image.Id == CurrentImage?.Id ? "selected" : "")"
                                    @onclick="() => SelectImage(image.Id)"
                                    title="@image.Source @image.Type"
                                    aria-label="Show @image.Source @image.Type">
                                <img src="@(image.LocalImagePath ?? image.ImageUrl)" alt="@anime.Title @image.Type" onerror="this.style.display='none'" />
                                @if (image.Id == anime.PreferredImageId)
                                {
                                    <span class="artwork-main-badge">Main</span>
                                }
                            </button>
                        }
                    </div>
                    </div>
                </details>
            }

            @if (!string.IsNullOrEmpty(anime.Synopsis))
            {
                <div class="synopsis-section">
                    <h2>Synopsis</h2>
                    <p class="synopsis-text">@anime.Synopsis</p>
                </div>
            }

            @if (isLoadingRecommendations || Recommendations.Count > 0)
            {
                <details class="detail-collapsible relations-section">
                    <summary>Recommendations (@Recommendations.Count)</summary>
                    <div class="detail-collapsible-content">
                    @if (isLoadingRecommendations)
                    {
                        <div class="relations-loading">
                            <span class="spinner-small"></span>
                            <span>Loading cached recommendations...</span>
                        </div>
                    }
                    else
                    {
                        <div class="synced-anime-grid recommendation-grid">
                            @foreach (var recommendation in Recommendations)
                            {
                                <a class="synced-anime-card" href="/anime/@recommendation.AnimeId" title="@recommendation.Name">
                                    <div class="synced-anime-image-wrapper">
                                        @if (!string.IsNullOrEmpty(recommendation.LocalImagePath) || !string.IsNullOrEmpty(recommendation.ImageUrl))
                                        {
                                            <img src="@(recommendation.LocalImagePath ?? recommendation.ImageUrl)" alt="@recommendation.Name cover" class="synced-anime-image" onerror="this.src='/images/placeholder.png'; this.onerror=null;" />
                                        }
                                        else { <div class="synced-anime-placeholder">&#x1F3AC;</div> }
                                    </div>
                                    <span class="synced-anime-title">@recommendation.Name</span>
                                </a>
                            }
                        </div>
                    }
                    </div>
                </details>
            }

            @if (isLoadingRelatedAnime || RelatedAnimeGroups.Count > 0)
            {
                <details class="detail-collapsible relations-section">
                    <summary>Related Anime (@(anime?.RelatedAnime.Count ?? 0))</summary>
                    <div class="detail-collapsible-content">
                    @if (isLoadingRelatedAnime)
                    {
                        <div class="relations-loading"><span class="spinner-small"></span><span>Loading cached related anime...</span></div>
                    }
                    else
                    {
                        @foreach (var group in RelatedAnimeGroups)
                        {
                            <div class="relation-group"><span class="relation-type">@group.Key</span><div class="relation-entries">
                                @foreach (var relatedAnime in group.Value) { <a href="/anime/@relatedAnime.AnimeId" class="relation-entry">@relatedAnime.Name</a> }
                            </div></div>
                        }
                    }
                    </div>
                </details>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <span class="empty-icon">&#x1F6AB;</span>
            <h3>Anime not found</h3>
            <p>The requested anime could not be loaded.</p>
            <button class="btn btn-primary" @onclick="goBack">Go Back</button>
        </div>
    }
</div>

@if (_isPreviewExpanded && CurrentImage is not null)
{
    <div class="artwork-lightbox" role="dialog" aria-modal="true" aria-label="Expanded artwork preview" @onclick="ClosePreview">
        <div class="artwork-lightbox-content" @onclick:stopPropagation="true">
            <button class="artwork-lightbox-close" @onclick="ClosePreview" aria-label="Close expanded preview">&times;</button>
            <img src="@(CurrentImage.LocalImagePath ?? CurrentImage.ImageUrl)" alt="Expanded @anime?.Title @CurrentImage.Type artwork" />
        </div>
    </div>
}

@if (_showPicker && _pickerResults != null)
{
    <MediaPickerModal Results="_pickerResults"
                      MediaType="@(_requestToRadarr ? "Movie" : "Series")"
                      OnSelected="OnPickerSelected" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Anime? anime;
    private bool isLoading = true;
    private bool isRefreshing = false;
    private bool isLoadingRecommendations = false;
    private bool isLoadingRelatedAnime = false;
    private bool _isRequesting = false;
    private (bool Ok, string Msg)? _requestResult;
    private bool _showPicker;
    private List<MediaLookupResult>? _pickerResults;
    private bool _inLibrary;
    private bool _requestToRadarr;
    private int? _selectedImageId;
    private bool _isSettingPoster;
    private string? _posterMessage;
    private bool _isPreviewExpanded;
    private string _customEnglishTitle = string.Empty;
    private List<QuickFilterRanking> _quickFilterRankings = [];

    private List<AnimeRelation> Recommendations => anime?.Relations ?? [];
    private static readonly string[] RelationOrder = ["Prequel", "Sequel", "Parent Story", "Side Story", "Alternative Version", "Summary", "Full Story", "Character", "Other", "Adaptation"];
    private Dictionary<string, List<AnimeRelation>> RelatedAnimeGroups => anime?.RelatedAnime
        .GroupBy(item => item.RelationType)
        .OrderBy(group => Array.IndexOf(RelationOrder, group.Key) is var index && index >= 0 ? index : 99)
        .ToDictionary(group => group.Key, group => group.ToList()) ?? new();

    private List<AnimeImage> GalleryImages => anime?.Images
        .OrderBy(image => image.Type)
        .ThenBy(image => image.Source)
        .ToList() ?? [];

    private List<string> DisplayAliases => anime is null ? [] : new[] { anime.OriginalTitle }
        .Concat(anime.TitleAliases.Select(alias => alias.Title))
        .Select(title => title?.Trim() ?? string.Empty)
        .Where(title => !string.IsNullOrWhiteSpace(title)
            && !string.Equals(title, anime.Title, StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(title => title, StringComparer.OrdinalIgnoreCase)
        .ToList() ?? [];

    private async Task SetMainEnglishTitleAsync(string title)
    {
        if (anime is null || !await AnimeReviewService.SetMainEnglishTitleAsync(anime.Id, title)) return;
        anime = await AnimeDataSource.GetByIdAsync(anime.Id);
    }

    private async Task SetCustomEnglishTitleAsync()
    {
        if (anime is null || string.IsNullOrWhiteSpace(_customEnglishTitle)) return;
        if (await AnimeReviewService.SetMainEnglishTitleAsync(anime.Id, _customEnglishTitle, allowCustom: true))
        {
            anime = await AnimeDataSource.GetByIdAsync(anime.Id);
            _customEnglishTitle = string.Empty;
        }
    }

    private AnimeImage? CurrentImage => GalleryImages.FirstOrDefault(image => image.Id == _selectedImageId)
        ?? anime?.PreferredImage
        ?? GalleryImages.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await MediaLibraryService.EnsureRefreshedAsync();
            anime = await AnimeDataSource.GetByIdAsync(Id);
            if (anime != null)
            {
                _selectedImageId = anime.PreferredImageId;
                _inLibrary = MediaLibraryService.IsInSonarr(anime)
                          || MediaLibraryService.IsInRadarr(anime);
                _quickFilterRankings = await AnimeDataSource.GetQuickFilterRankingsAsync(anime.Id);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching anime details: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }

        if (anime != null)
        {
            _ = LoadRecommendationsAsync(anime.Id);
            _ = LoadRelatedAnimeAsync(anime.Id);
        }
    }

    private async Task LoadRecommendationsAsync(int animeId)
    {
        isLoadingRecommendations = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var relations = await AnimeDataSource.GetRecommendationsAsync(animeId);
            if (anime != null)
                anime.Relations = relations;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading recommendations: {ex.Message}");
        }
        finally
        {
            isLoadingRecommendations = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshAsync()
    {
        isRefreshing = true;
        try
        {
            anime = await AnimeDataSource.GetByIdAsync(Id, forceRefresh: true);
            if (anime != null)
            {
                _selectedImageId = anime.PreferredImageId;
                _quickFilterRankings = await AnimeDataSource.GetQuickFilterRankingsAsync(anime.Id);
                _ = LoadRecommendationsAsync(anime.Id);
                _ = LoadRelatedAnimeAsync(anime.Id);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing anime details: {ex.Message}");
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private async Task RequestAsync(bool? useRadarr = null)
    {
        _isRequesting = true;
        _requestResult = null;
        _requestToRadarr = useRadarr ?? anime!.Type == "Movie";
        try
        {
            var lookup = _requestToRadarr
                ? await MediaRequestService.LookupRadarrAsync(anime.Title)
                : await MediaRequestService.LookupSonarrAsync(anime.Title);

            if (!lookup.Ok || lookup.Results == null)
            {
                _requestResult = (false, lookup.Error);
                return;
            }

            _pickerResults = lookup.Results;
            _showPicker = true;
        }
        catch (Exception ex)
        {
            _requestResult = (false, ex.Message.Split('.')[0]);
        }
        finally
        {
            _isRequesting = false;
        }
    }

    private async Task OnPickerSelected(MediaLookupResult? selected)
    {
        _showPicker = false;
        _pickerResults = null;
        if (selected == null) return;

        _isRequesting = true;
        try
        {
            _requestResult = _requestToRadarr
                ? await MediaRequestService.AddToRadarrAsync(selected.RawData)
                : await MediaRequestService.AddToSonarrAsync(selected.RawData);
            if (_requestResult.Value.Ok)
            {
                MediaLibraryService.Invalidate();
                _inLibrary = true;
            }
        }
        catch (Exception ex)
        {
            _requestResult = (false, ex.Message.Split('.')[0]);
        }
        finally
        {
            _isRequesting = false;
        }
    }

    private void goBack() => NavManager.NavigateTo("/");

    private void SelectImage(int imageId)
    {
        _selectedImageId = imageId;
        _posterMessage = null;
    }

    private void ExpandPreview() => _isPreviewExpanded = true;

    private void ClosePreview() => _isPreviewExpanded = false;

    private async Task SetCurrentImageAsPosterAsync()
    {
        if (anime is null || CurrentImage is null) return;

        _isSettingPoster = true;
        _posterMessage = null;
        try
        {
            if (await AnimeDataSource.SetPreferredImageAsync(anime.Id, CurrentImage.Id))
            {
                anime.PreferredImageId = CurrentImage.Id;
                _posterMessage = "Main poster updated.";
            }
            else
            {
                _posterMessage = "That artwork is no longer available.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting main poster: {ex.Message}");
            _posterMessage = "Could not update the main poster.";
        }
        finally
        {
            _isSettingPoster = false;
        }
    }

    private async Task LoadRelatedAnimeAsync(int animeId)
    {
        isLoadingRelatedAnime = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var relatedAnime = await AnimeDataSource.GetRelatedAnimeAsync(animeId);
            if (anime != null) anime.RelatedAnime = relatedAnime;
        }
        catch (Exception ex) { Console.WriteLine($"Error loading related anime: {ex.Message}"); }
        finally
        {
            isLoadingRelatedAnime = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string NormalizeStatus(string status) =>
        status.ToLower().Replace(" ", "-").Replace(":", "");
}
