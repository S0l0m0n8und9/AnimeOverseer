@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AnimeOverseer.Server.Models
@using AnimeOverseer.Server.Services
@using AnimeOverseer.Server.BackgroundServices
@using AnimeOverseer.Server.Pages
@using System.Text.Json
@inject SettingsService SettingsService
@inject SyncJobService SyncJobService
@inject IntegrationScheduleService IntegrationScheduleService
@inject SyncJobTrigger SyncJobTrigger
@inject StorageUsageService StorageUsageService
@inject IHttpClientFactory HttpClientFactory
@inject MyAnimeListApiService MyAnimeListApiService
@inject AnimeScheduleApiService AnimeScheduleApiService
@implements IDisposable

<PageTitle>Settings - AnimeOverseer</PageTitle>

<div class="settings-page">
    <div class="settings-header">
        <span class="settings-eyebrow">Configuration</span>
        <h1 class="settings-title">Settings</h1>
        <p>Manage your catalogue syncs, media connections, and recent activity.</p>
    </div>

    <div class="settings-tabs" role="tablist" aria-label="Settings sections">
        <a role="tab" class="settings-tab @TabClass(SettingsTab.Sources)" href="@TabUrl(SettingsTab.Sources)"
           aria-selected="@(_activeTab == SettingsTab.Sources)">
            Data sources
        </a>
        <a role="tab" class="settings-tab @TabClass(SettingsTab.Servers)" href="@TabUrl(SettingsTab.Servers)"
           aria-selected="@(_activeTab == SettingsTab.Servers)">
            Media servers
        </a>
        <a role="tab" class="settings-tab @TabClass(SettingsTab.History)" href="@TabUrl(SettingsTab.History)"
           aria-selected="@(_activeTab == SettingsTab.History)">
            Job history
        </a>
        <a role="tab" class="settings-tab @TabClass(SettingsTab.Storage)" href="@TabUrl(SettingsTab.Storage)"
           aria-selected="@(_activeTab == SettingsTab.Storage)">
            Storage
        </a>
        <a role="tab" class="settings-tab @TabClass(SettingsTab.Review)" href="@TabUrl(SettingsTab.Review)"
           aria-selected="@(_activeTab == SettingsTab.Review)">
            Review matches
        </a>
    </div>

    @if (_activeTab == SettingsTab.Review)
    {
        <AnimeReview />
    }

    @if (_activeTab == SettingsTab.Sources)
    {
    <!-- ══ Data Sources ══════════════════════════════════════════════════ -->
    <h2>Data Sources</h2>

    <section class="settings-card" style="margin-bottom:1rem">
        <div style="display:flex;justify-content:space-between;gap:1rem;align-items:start;flex-wrap:wrap">
            <div>
                <h3 style="margin:0 0 .25rem">Automatic integrations</h3>
                <p style="margin:0;color:#aaa;font-size:.9em">Create independent schedules for the same source. Each schedule has its own recurrence, range and catalogue work.</p>
            </div>
            <button class="btn btn-primary" @onclick="NewSchedule">New schedule</button>
        </div>
        @if (_editingSchedule is not null)
        {
            var schedule = _editingSchedule;
            <div style="border-top:1px solid #333;margin-top:1rem;padding-top:1rem;display:grid;gap:.75rem">
                <div style="display:flex;gap:.7rem;flex-wrap:wrap;align-items:end">
                    <label>Schedule name<input class="form-input" style="display:block" @bind="schedule.Name" /></label>
                    <label>Source<select class="form-input" style="display:block" @bind="schedule.Source">@foreach (var source in IntegrationScheduleService.CatalogueSources) { <option value="@source">@source</option> }</select></label>
                    <label>Work type<select class="form-input" style="display:block" @bind="schedule.WorkType"><option value="CatalogueSync">Catalogue sync</option><option value="InitialMigration">Initial migration</option></select></label>
                    <label style="display:flex;gap:.35rem;align-items:center;height:38px"><input type="checkbox" @bind="schedule.Enabled" /> Enabled</label>
                </div>
                <div style="display:flex;gap:.7rem;flex-wrap:wrap;align-items:end">
                    <label>Starts<input class="form-input" type="datetime-local" style="display:block" @bind-value="schedule.StartAt" @bind-value:format="yyyy-MM-ddTHH:mm" /></label>
                    <button type="button" class="btn btn-secondary" style="margin-bottom:.1rem" @onclick="() => StartScheduleImmediately(schedule)">Start immediately</button>
                    <label>Pattern<select class="form-input" style="display:block" @bind="schedule.RecurrenceType"><option value="Once">Does not repeat</option><option>Daily</option><option>Weekly</option><option>Monthly</option><option>Yearly</option></select></label>
                    @if (schedule.RecurrenceType != "Once") { <label>Every<input class="form-input" type="number" min="1" style="display:block;width:5rem" @bind="schedule.Interval" /></label><span style="color:#aaa;margin-bottom:.55rem">@RecurrenceUnit(schedule.RecurrenceType, schedule.Interval)</span> }
                </div>
                @if (schedule.RecurrenceType == "Weekly")
                {
                    <div><span style="color:#aaa">On </span>@foreach (var day in DaysOfWeek) { <label style="margin-left:.6rem"><input type="checkbox" checked="@ScheduleHasWeekday(schedule, day.Value)" @onchange="e => ToggleScheduleWeekday(schedule, day.Value, (bool)e.Value!)" /> @day.Name</label> }</div>
                }
                @if (schedule.RecurrenceType == "Monthly")
                {
                    <div style="display:flex;gap:.7rem;align-items:end;flex-wrap:wrap">
                        <label>Monthly rule <select class="form-input" @bind="schedule.MonthlyMode"><option value="DayOfMonth">Day of month</option><option value="NthWeekday">Nth weekday</option></select></label>
                        @if (schedule.MonthlyMode == "DayOfMonth") { <label>Day <input class="form-input" type="number" min="1" max="31" style="width:4.5rem" @bind="schedule.DayOfMonth" /></label> }
                        else { <label>The <select class="form-input" @bind="schedule.NthWeek"><option value="1">first</option><option value="2">second</option><option value="3">third</option><option value="4">fourth</option><option value="5">last</option></select> <select class="form-input" @bind="schedule.Weekday">@foreach (var day in DaysOfWeek) { <option value="@day.Value">@day.Name</option> }</select></label> }
                    </div>
                }
                <div style="border-top:1px solid #333;padding-top:.75rem"><strong>Work to perform</strong>
                    @if (schedule.WorkType == "InitialMigration") { <p style="color:#aaa;font-size:.85em;margin:.3rem 0">Imports one selected season at a time and automatically queues the next one until the configured year range is complete.</p> }
                    <div style="display:flex;gap:.7rem;align-items:end;flex-wrap:wrap;margin-top:.45rem">
                        <label>Starting year<input class="form-input" type="number" style="display:block;width:6rem" @bind="schedule.YearOffset" /></label>
                        <span style="color:#aaa;margin-bottom:.55rem">relative to the current year (@(DateTime.UtcNow.Year + schedule.YearOffset))</span>
                        <label>Years<input class="form-input" type="number" min="1" style="display:block;width:5rem" @bind="schedule.YearCount" /></label>
                        <span style="color:#aaa;margin-bottom:.55rem">(@YearScopeText(schedule))</span>
                    </div>
                    <div style="margin-top:.45rem"><span style="color:#aaa">Seasons: </span>@foreach (var season in SeasonOptions) { <label style="margin-left:.6rem"><input type="checkbox" checked="@ScheduleHasSeason(schedule, season)" @onchange="e => ToggleScheduleSeason(schedule, season, (bool)e.Value!)" /> @Capitalize(season)</label> } <button type="button" class="btn btn-secondary" style="font-size:.8em;padding:.15rem .4rem;margin-left:.6rem" @onclick="() => UseRemainingSeasons(schedule)">Use remaining current-year seasons</button></div>
                </div>
                @if (schedule.RecurrenceType != "Once")
                {
                <div style="border-top:1px solid #333;padding-top:.75rem"><strong>Range of recurrence</strong>
                    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:.45rem;align-items:center">
                        <label>Ends <select class="form-input" @bind="schedule.EndType"><option value="Never">No end date</option><option value="After">After occurrences</option><option value="By">On date</option></select></label>
                        @if (schedule.EndType == "After") { <label>Occurrences <input class="form-input" type="number" min="1" style="width:5rem" @bind="schedule.EndAfterOccurrences" /></label> }
                        @if (schedule.EndType == "By") { <label>End by <input class="form-input" type="date" @bind-value="schedule.EndBy" @bind-value:format="yyyy-MM-dd" /></label> }
                    </div>
                </div>
                }
                <div style="border-top:1px solid #333;padding-top:.75rem"><strong>Next occurrences</strong><ol style="margin:.35rem 0 0;padding-left:1.4rem">@foreach (var occurrence in PreviewOccurrences(schedule)) { <li>@occurrence.ToLocalTime().ToString("ddd, d MMM yyyy h:mm tt")</li> }</ol></div>
                <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap"><button class="btn btn-primary" @onclick="SaveScheduleAsync">Save schedule</button><button class="btn btn-secondary" @onclick="CancelSchedule">Cancel</button>@if (schedule.Id != 0) { <label style="color:#aaa;font-size:.9em;margin-left:.5rem"><input type="checkbox" @bind="_restartScheduleOnSave" /> Run schedule again after saving</label> }</div>
            </div>
        }
        <div style="display:grid;gap:.65rem;margin-top:.75rem">
            @foreach (var schedule in _integrationSchedules)
            {
                var activeMigration = schedule.WorkType == "InitialMigration" ? ActiveMigrationFor(schedule.Source) : null;
                <div style="border-top:1px solid #333;padding-top:.65rem">
                    <div style="display:flex;gap:.8rem;align-items:center;flex-wrap:wrap"><strong>@schedule.Name</strong><span>@schedule.Source</span><span>@(schedule.WorkType == "InitialMigration" ? "Initial migration" : "Catalogue sync")</span><span style="color:#aaa">@DescribeSchedule(schedule)</span><span style="color:#888">@(schedule.Enabled ? "Enabled" : "Disabled")</span>@if (activeMigration is not null) { <span style="color:#90caf9">@activeMigration.Status #@activeMigration.Id</span><button class="btn btn-secondary" @onclick="() => CancelMigrationAsync(activeMigration.Id)">Cancel migration</button> }<button class="btn btn-secondary" style="margin-left:auto" @onclick="() => EditSchedule(schedule)">Edit</button><button class="btn btn-secondary" @onclick="() => DeleteScheduleAsync(schedule.Id)">Remove</button></div>
                    <div style="font-size:.85em;color:#aaa;margin-top:.35rem">Next: @string.Join(" · ", PreviewOccurrences(schedule).Take(4).Select(d => d.ToLocalTime().ToString("d MMM h:mm tt")))</div>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(_integrationMessage)) { <p style="margin:.65rem 0 0;color:#aaa;font-size:.85em">@_integrationMessage</p> }
    </section>

    <div class="settings-card-grid settings-card-grid--sources">
        @foreach (var src in new[]
        {
            ("AniList", "AniList catalogue"),
            ("MyAnimeList", "MyAnimeList catalogue"),
            ("AnimeSchedule", "AnimeSchedule catalogue")
        })
        {
            var (type, label) = src;
            var active = IsActive(type);
            var last = LastJob(type);
            <div class="settings-card" style="min-width:220px;flex:1">
                <div style="font-weight:600;margin-bottom:.5rem">@label</div>
                @if (active != null)
                {
                    <div style="margin-bottom:.5rem">
                        @StatusBadge(active.Status)
                        <span style="margin-left:.5rem;font-size:.85em">
                            @if (active.TotalCount > 0)
                            {
                                @($"{active.ProcessedCount:N0} / {active.TotalCount:N0}")
                            }
                            else if (active.ProcessedCount > 0)
                            {
                                @($"{active.ProcessedCount:N0} anime")
                            }
                        </span>
                    </div>
                    @if (active.TotalCount > 0)
                    {
                        var pct = active.ProcessedCount * 100 / active.TotalCount;
                        <div style="background:#333;height:6px;border-radius:3px;overflow:hidden;margin-bottom:.5rem">
                            <div style="background:#0d6efd;height:100%;width:@(pct)%;transition:width .3s"></div>
                        </div>
                    }
                }
                else if (last != null)
                {
                    <div style="font-size:.8em;color:#888;margin-bottom:.5rem">
                        Last: @StatusBadge(last.Status) @FormatAgo(last.FinishedAt ?? last.QueuedAt)
                    </div>
                }
                else
                {
                    <div style="font-size:.8em;color:#888;margin-bottom:.5rem">Never run</div>
                }

                @if (type is "AniList" or "MyAnimeList" or "AnimeSchedule")
                {
                    <div style="margin-bottom:.5rem">
                        <div style="font-size:.78em;color:#aaa;margin-bottom:.3rem">Years</div>
                        <div style="max-height:130px;overflow-y:auto;border:1px solid #444;border-radius:4px;padding:.3rem .4rem;background:#1a1a1a">
                            @foreach (var yr in JikanYearList())
                            {
                                var y = yr;
                                <label style="font-size:.82em;display:flex;align-items:center;gap:.25rem;cursor:pointer;padding:.1rem 0">
                                    <input type="checkbox" checked="@_jikanYears.Contains(y)"
                                           @onchange="e => ToggleJikanYear(y, (bool)e.Value!)" />
                                    @y
                                </label>
                            }
                        </div>
                        <div style="display:flex;gap:.3rem;margin-top:.3rem">
                            <input class="form-input" style="flex:1;font-size:.82em;padding:.2rem .4rem"
                                   type="number" min="1900" max="2200" placeholder="Add year…"
                                   @bind="_jikanCustomYear" @bind:event="oninput"
                                   @onkeydown="OnCustomYearKeyDown" />
                            <button class="btn btn-secondary" style="font-size:.78em;padding:.2rem .5rem"
                                    @onclick="AddCustomJikanYear"
                                    disabled="@(!IsValidCustomYear())">Add</button>
                        </div>
                    </div>
                    <div style="margin-bottom:.75rem">
                        <div style="font-size:.78em;color:#aaa;margin-bottom:.3rem">Seasons</div>
                        <div style="display:flex;flex-wrap:wrap;gap:.2rem .6rem">
                            @foreach (var s in new[] { "spring", "summer", "fall", "winter" })
                            {
                                var season = s;
                                <label style="font-size:.82em;display:flex;align-items:center;gap:.25rem;cursor:pointer">
                                    <input type="checkbox" checked="@_jikanSeasons.Contains(season)"
                                           @onchange="e => ToggleJikanSeason(season, (bool)e.Value!)" />
                                    @(char.ToUpper(season[0]) + season[1..])
                                </label>
                            }
                        </div>
                    </div>
                }

                <button class="btn btn-primary" style="font-size:.85em;padding:.3rem .8rem"
                        @onclick="() => TriggerSync(type)"
                        disabled="@(active != null || _triggering || !CanSync(type) || (_jikanYears.Count == 0 || _jikanSeasons.Count == 0))">
                    Sync Now
                </button>
                @if (!CanSync(type))
                {
                    <span style="font-size:.78em;color:#888">Configure and validate this source first.</span>
                }
            </div>
        }

        @* MyAnimeList catalogue connection *@
        <div class="settings-card" style="min-width:220px;flex:1">
            <h3 style="margin-top:0;font-size:1.1rem">MyAnimeList</h3>
            <p style="font-size:.82em;color:#aaa;margin-top:0">Catalogue access only. A MyAnimeList client ID is all that is needed.</p>
            <div style="margin-bottom:.55rem">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem">Client ID</label>
                <input class="form-input" style="width:100%" @bind="_malClientId" autocomplete="off" />
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <button class="btn btn-primary" @onclick="SaveMyAnimeList" style="font-size:.85em" disabled="@_malSaving">@(_malSaving ? "Validating…" : "Save & Validate")</button>
                @TestResultBadge(_malResult)
            </div>
        </div>

        @* AnimeSchedule catalogue connection *@
        <div class="settings-card" style="min-width:220px;flex:1">
            <h3 style="margin-top:0;font-size:1.1rem">AnimeSchedule</h3>
            <p style="font-size:.82em;color:#aaa;margin-top:0">Catalogue access only. Use the application API token from AnimeSchedule.</p>
            <div style="margin-bottom:.75rem">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem">Application API token</label>
                <input class="form-input" style="width:100%" @bind="_animeScheduleApplicationToken" type="password" autocomplete="new-password" />
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <button class="btn btn-primary" @onclick="SaveAnimeSchedule" style="font-size:.85em" disabled="@_animeScheduleSaving">@(_animeScheduleSaving ? "Validating…" : "Save & Validate")</button>
                @TestResultBadge(_animeScheduleResult)
            </div>
        </div>
    </div>
    }

    @if (_activeTab == SettingsTab.History)
    {
    <!-- ══ Job History ═══════════════════════════════════════════════════ -->
    <h2>Job History</h2>
    <button class="btn btn-primary" style="font-size:.85em;padding:.3rem .8rem;margin-bottom:.75rem"
            @onclick="RunQueuedJobsNowAsync" disabled="@(!HasQueuedJobs)">
        Run queued jobs now
    </button>

    @if (_jobs.Count == 0)
    {
        <p style="color:#888">No jobs run yet.</p>
    }
    else
    {
        <div style="display:flex;justify-content:space-between;align-items:center;gap:.75rem;flex-wrap:wrap;margin-bottom:.5rem;font-size:.85em;color:#aaa">
            <span>Showing @(((_jobsPage - 1) * _jobsPerPage) + 1)–@Math.Min(_jobsPage * _jobsPerPage, _totalJobs) of @_totalJobs jobs</span>
            <label style="display:flex;align-items:center;gap:.4rem">
                Jobs per page
                <select @bind="_jobsPerPage" @bind:after="ChangePageSizeAsync" style="background:#1a1a1a;color:#ddd;border:1px solid #444;border-radius:4px;padding:.2rem .35rem">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
        <div class="settings-table-wrapper">
        <table class="settings-table">
            <thead>
                <tr style="border-bottom:1px solid #333;text-align:left">
                    <th style="padding:.4rem .6rem">Type</th>
                    <th style="padding:.4rem .6rem">Status</th>
                    <th style="padding:.4rem .6rem">Queued</th>
                    <th style="padding:.4rem .6rem">Duration</th>
                    <th style="padding:.4rem .6rem">Progress</th>
                    <th style="padding:.4rem .6rem">Message</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in _jobs)
                {
                    <tr style="border-bottom:1px solid #222">
                        <td style="padding:.4rem .6rem"><a href="/jobs/@job.Id" style="color:#90caf9;text-decoration:none">@job.JobType #@job.Id</a></td>
                        <td style="padding:.4rem .6rem">@StatusBadge(job.Status)</td>
                        <td style="padding:.4rem .6rem;color:#888;font-size:.85em">@FormatAgo(job.QueuedAt)</td>
                        <td style="padding:.4rem .6rem;color:#888;font-size:.85em">@FormatDuration(job)</td>
                        <td style="padding:.4rem .6rem;min-width:120px">
                            @if (job.TotalCount > 0)
                            {
                                var pct = job.ProcessedCount * 100 / job.TotalCount;
                                <div style="background:#333;height:5px;border-radius:3px;overflow:hidden;margin-bottom:2px">
                                    <div style="background:#0d6efd;height:100%;width:@(pct)%"></div>
                                </div>
                                <span style="font-size:.8em;color:#888">@job.ProcessedCount / @job.TotalCount</span>
                            }
                        </td>
                        <td style="padding:.4rem .6rem;color:#888;font-size:.85em">@job.Message</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        @if (PageCount > 1)
        {
            <div style="display:flex;justify-content:center;align-items:center;gap:.5rem;margin-bottom:2rem">
                <button class="btn btn-secondary" style="font-size:.85em;padding:.25rem .6rem" @onclick="() => GoToPageAsync(_jobsPage - 1)" disabled="@(_jobsPage == 1)">Previous</button>
                <span style="font-size:.85em;color:#aaa">Page @_jobsPage of @PageCount</span>
                <button class="btn btn-secondary" style="font-size:.85em;padding:.25rem .6rem" @onclick="() => GoToPageAsync(_jobsPage + 1)" disabled="@(_jobsPage == PageCount)">Next</button>
            </div>
        }
    }
    }

    @if (_activeTab == SettingsTab.Storage)
    {
    <!-- ══ Storage ═══════════════════════════════════════════════════════ -->
    <div class="settings-section-heading">
        <div>
            <h2>Storage usage</h2>
            <p>Space used by AnimeOverseer’s local data.</p>
        </div>
        <button class="btn btn-secondary" @onclick="LoadStorageUsageAsync" disabled="@_loadingStorage">
            @(_loadingStorage ? "Refreshing…" : "Refresh")
        </button>
    </div>

    @if (_storageUsage is null)
    {
        <p style="color:#888">Loading storage usage…</p>
    }
    else
    {
        <div class="settings-card-grid settings-card-grid--storage">
            <div class="settings-card storage-card">
                <span class="storage-card-label">Database</span>
                <strong class="storage-card-value">@FormatBytes(_storageUsage.DatabaseBytes)</strong>
                <span class="storage-card-detail">SQLite database, including active journal files</span>
            </div>
            <div class="settings-card storage-card">
                <span class="storage-card-label">Stored pictures</span>
                <strong class="storage-card-value">@FormatBytes(_storageUsage.ImageCacheBytes)</strong>
                <span class="storage-card-detail">@_storageUsage.ImageCount cached cover @(_storageUsage.ImageCount == 1 ? "image" : "images")</span>
            </div>
        </div>
    }
    }

    @if (_activeTab == SettingsTab.Servers)
    {
    <!-- ══ Media Servers ════════════════════════════════════════════════ -->
    <h2>Media Servers</h2>

    <div class="settings-card-grid settings-card-grid--servers">

        @* Sonarr *@
        <div class="settings-card">
            <h3 style="margin-top:0;font-size:1.1rem">Sonarr</h3>
            <!-- The text and password here are to prevent FF from auto filling my login credentials because it ignores autocomplete="off"-->
            <input type="text" style="display:none">
            <input type="password" style="display:none">
            <div style="margin-bottom:.75rem">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem">URL</label>
                <input class="form-input" style="width:100%" @bind="_sonarrUrl" placeholder="http://sonarr:8989" />
            </div>
            <div style="margin-bottom:.75rem;display:flex;align-items:center;autocomplete:off">                
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem;flex:1">API Key</label>
                <div style="display:flex;align-items:center;gap:.25rem;">
                    <input class="form-input" style="flex:1" @bind="_sonarrKey" type=@(_showSonarrKey ? "text" : "password") placeholder="••••••••" autocomplete="off" />
                    <button class="btn btn-secondary" style="font-size:.75em;padding:.2rem .4rem" @onclick="() => _showSonarrKey = !_showSonarrKey">
                        @(_showSonarrKey ? "Hide" : "Show")
                    </button>
                </div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <button class="btn btn-primary" @onclick="SaveSonarr" style="font-size:.85em">Save</button>
                <button class="btn btn-secondary" @onclick="TestSonarr" disabled="@_sonarrTesting" style="font-size:.85em">
                    @(_sonarrTesting ? "Testing…" : "Test Connection")
                </button>
                @TestResultBadge(_sonarrResult)
            </div>
        </div>

        @* Radarr *@
        <div class="settings-card">
            <h3 style="margin-top:0;font-size:1.1rem">Radarr</h3>
            <div style="margin-bottom:.75rem">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem">URL</label>
                <input class="form-input" style="width:100%" @bind="_radarrUrl" placeholder="http://radarr:7878" />
            </div>
            <div style="margin-bottom:.75rem;display:flex;align-items:center;autocomplete:off">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem;flex:1">API Key</label>
                <div style="display:flex;align-items:center;gap:.25rem;">
                    <input class="form-input" style="flex:1" @bind="_radarrKey" type=@(_showRadarrKey ? "text" : "password") placeholder="••••••••" autocomplete="off" />
                    <button class="btn btn-secondary" style="font-size:.75em;padding:.2rem .4rem" @onclick="() => _showRadarrKey = !_showRadarrKey">
                        @(_showRadarrKey ? "Hide" : "Show")
                    </button>
                </div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
