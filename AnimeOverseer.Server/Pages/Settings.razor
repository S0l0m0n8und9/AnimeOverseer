@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AnimeOverseer.Server.Models
@using AnimeOverseer.Server.Services
@using System.Text.Json
@inject SettingsService SettingsService
@inject SyncJobService SyncJobService
@inject IHttpClientFactory HttpClientFactory
@implements IDisposable

<PageTitle>Settings - AnimeOverseer</PageTitle>

<div class="settings-page" style="max-width:900px;margin:0 auto;padding:1.5rem">

    <!-- ══ Data Sources ══════════════════════════════════════════════════ -->
    <h2 style="margin-top:0">Data Sources</h2>

    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem">
        @foreach (var src in new[] { ("Jikan", "MyAnimeList via Jikan"), ("AniList", "AniList"), ("Kitsu", "Kitsu") })
        {
            var (type, label) = src;
            var active = IsActive(type);
            var last = LastJob(type);
            <div style="border:1px solid #333;border-radius:8px;padding:1rem;min-width:220px;flex:1">
                <div style="font-weight:600;margin-bottom:.5rem">@label</div>
                @if (active != null)
                {
                    <div style="margin-bottom:.5rem">
                        @StatusBadge(active.Status)
                        <span style="margin-left:.5rem;font-size:.85em">
                            @if (active.TotalCount > 0)
                            {
                                @($"{active.ProcessedCount:N0} / {active.TotalCount:N0}")
                            }
                            else if (active.ProcessedCount > 0)
                            {
                                @($"{active.ProcessedCount:N0} anime")
                            }
                        </span>
                    </div>
                    @if (active.TotalCount > 0)
                    {
                        var pct = active.ProcessedCount * 100 / active.TotalCount;
                        <div style="background:#333;height:6px;border-radius:3px;overflow:hidden;margin-bottom:.5rem">
                            <div style="background:#0d6efd;height:100%;width:@(pct)%;transition:width .3s"></div>
                        </div>
                    }
                }
                else if (last != null)
                {
                    <div style="font-size:.8em;color:#888;margin-bottom:.5rem">
                        Last: @StatusBadge(last.Status) @FormatAgo(last.FinishedAt ?? last.QueuedAt)
                    </div>
                }
                else
                {
                    <div style="font-size:.8em;color:#888;margin-bottom:.5rem">Never run</div>
                }

                @if (type == "Jikan")
                {
                    <div style="margin-bottom:.5rem">
                        <div style="font-size:.78em;color:#aaa;margin-bottom:.3rem">Years</div>
                        <div style="max-height:130px;overflow-y:auto;border:1px solid #444;border-radius:4px;padding:.3rem .4rem;background:#1a1a1a">
                            @foreach (var yr in JikanYearList())
                            {
                                var y = yr;
                                <label style="font-size:.82em;display:flex;align-items:center;gap:.25rem;cursor:pointer;padding:.1rem 0">
                                    <input type="checkbox" checked="@_jikanYears.Contains(y)"
                                           @onchange="e => ToggleJikanYear(y, (bool)e.Value!)" />
                                    @y
                                </label>
                            }
                        </div>
                        <div style="display:flex;gap:.3rem;margin-top:.3rem">
                            <input class="form-input" style="flex:1;font-size:.82em;padding:.2rem .4rem"
                                   type="number" min="1900" max="2200" placeholder="Add year…"
                                   @bind="_jikanCustomYear" @bind:event="oninput"
                                   @onkeydown="OnCustomYearKeyDown" />
                            <button class="btn btn-secondary" style="font-size:.78em;padding:.2rem .5rem"
                                    @onclick="AddCustomJikanYear"
                                    disabled="@(!IsValidCustomYear())">Add</button>
                        </div>
                    </div>
                    <div style="margin-bottom:.75rem">
                        <div style="font-size:.78em;color:#aaa;margin-bottom:.3rem">Seasons</div>
                        <div style="display:flex;flex-wrap:wrap;gap:.2rem .6rem">
                            @foreach (var s in new[] { "spring", "summer", "fall", "winter" })
                            {
                                var season = s;
                                <label style="font-size:.82em;display:flex;align-items:center;gap:.25rem;cursor:pointer">
                                    <input type="checkbox" checked="@_jikanSeasons.Contains(season)"
                                           @onchange="e => ToggleJikanSeason(season, (bool)e.Value!)" />
                                    @(char.ToUpper(season[0]) + season[1..])
                                </label>
                            }
                        </div>
                    </div>
                }

                <button class="btn btn-primary" style="font-size:.85em;padding:.3rem .8rem"
                        @onclick="() => TriggerSync(type)"
                        disabled="@(active != null || _triggering || (type == "Jikan" && (_jikanYears.Count == 0 || _jikanSeasons.Count == 0)))">
                    Sync Now
                </button>
            </div>
        }
    </div>

    <!-- ══ Job History ═══════════════════════════════════════════════════ -->
    <h2>Job History</h2>

    @if (_jobs.Count == 0)
    {
        <p style="color:#888">No jobs run yet.</p>
    }
    else
    {
        <table style="width:100%;border-collapse:collapse;font-size:.9em;margin-bottom:2rem">
            <thead>
                <tr style="border-bottom:1px solid #333;text-align:left">
                    <th style="padding:.4rem .6rem">Type</th>
                    <th style="padding:.4rem .6rem">Status</th>
                    <th style="padding:.4rem .6rem">Queued</th>
                    <th style="padding:.4rem .6rem">Duration</th>
                    <th style="padding:.4rem .6rem">Progress</th>
                    <th style="padding:.4rem .6rem">Message</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in _jobs)
                {
                    <tr style="border-bottom:1px solid #222">
                        <td style="padding:.4rem .6rem"><a href="/jobs/@job.Id" style="color:#90caf9;text-decoration:none">@job.JobType #@job.Id</a></td>
                        <td style="padding:.4rem .6rem">@StatusBadge(job.Status)</td>
                        <td style="padding:.4rem .6rem;color:#888;font-size:.85em">@FormatAgo(job.QueuedAt)</td>
                        <td style="padding:.4rem .6rem;color:#888;font-size:.85em">@FormatDuration(job)</td>
                        <td style="padding:.4rem .6rem;min-width:120px">
                            @if (job.TotalCount > 0)
                            {
                                var pct = job.ProcessedCount * 100 / job.TotalCount;
                                <div style="background:#333;height:5px;border-radius:3px;overflow:hidden;margin-bottom:2px">
                                    <div style="background:#0d6efd;height:100%;width:@(pct)%"></div>
                                </div>
                                <span style="font-size:.8em;color:#888">@job.ProcessedCount / @job.TotalCount</span>
                            }
                        </td>
                        <td style="padding:.4rem .6rem;color:#888;font-size:.85em">@job.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- ══ Media Servers ════════════════════════════════════════════════ -->
    <h2>Media Servers</h2>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(400px,1fr));gap:1.5rem;margin-bottom:2rem">

        @* Sonarr *@
        <div style="border:1px solid #333;border-radius:8px;padding:1.25rem">
            <h3 style="margin-top:0;font-size:1.1rem">Sonarr</h3>
            <!-- The text and password here are to prevent FF from auto filling my login credentials because it ignores autocomplete="off"-->
            <input type="text" style="display:none">
            <input type="password" style="display:none">
            <div style="margin-bottom:.75rem">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem">URL</label>
                <input class="form-input" style="width:100%" @bind="_sonarrUrl" placeholder="http://sonarr:8989" />
            </div>
            <div style="margin-bottom:.75rem;display:flex;align-items:center;autocomplete:off">                
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem;flex:1">API Key</label>
                <div style="display:flex;align-items:center;gap:.25rem;">
                    <input class="form-input" style="flex:1" @bind="_sonarrKey" type=@(_showSonarrKey ? "text" : "password") placeholder="••••••••" autocomplete="off" />
                    <button class="btn btn-secondary" style="font-size:.75em;padding:.2rem .4rem" @onclick="() => _showSonarrKey = !_showSonarrKey">
                        @(_showSonarrKey ? "Hide" : "Show")
                    </button>
                </div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <button class="btn btn-primary" @onclick="SaveSonarr" style="font-size:.85em">Save</button>
                <button class="btn btn-secondary" @onclick="TestSonarr" disabled="@_sonarrTesting" style="font-size:.85em">
                    @(_sonarrTesting ? "Testing…" : "Test Connection")
                </button>
                @TestResultBadge(_sonarrResult)
            </div>
        </div>

        @* Radarr *@
        <div style="border:1px solid #333;border-radius:8px;padding:1.25rem">
            <h3 style="margin-top:0;font-size:1.1rem">Radarr</h3>
            <div style="margin-bottom:.75rem">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem">URL</label>
                <input class="form-input" style="width:100%" @bind="_radarrUrl" placeholder="http://radarr:7878" />
            </div>
            <div style="margin-bottom:.75rem;display:flex;align-items:center;autocomplete:off">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem;flex:1">API Key</label>
                <div style="display:flex;align-items:center;gap:.25rem;">
                    <input class="form-input" style="flex:1" @bind="_radarrKey" type=@(_showRadarrKey ? "text" : "password") placeholder="••••••••" autocomplete="off" />
                    <button class="btn btn-secondary" style="font-size:.75em;padding:.2rem .4rem" @onclick="() => _showRadarrKey = !_showRadarrKey">
                        @(_showRadarrKey ? "Hide" : "Show")
                    </button>
                </div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <button class="btn btn-primary" @onclick="SaveRadarr" style="font-size:.85em">Save</button>
                <button class="btn btn-secondary" @onclick="TestRadarr" disabled="@_radarrTesting" style="font-size:.85em">
                    @(_radarrTesting ? "Testing…" : "Test Connection")
                </button>
                @TestResultBadge(_radarrResult)
            </div>
        </div>

        @* Plex *@
        <div style="border:1px solid #333;border-radius:8px;padding:1.25rem">
            <h3 style="margin-top:0;font-size:1.1rem">Plex</h3>
            <div style="margin-bottom:.75rem">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem">Server URL</label>
                <input class="form-input" style="width:100%" @bind="_plexUrl" placeholder="http://plex:32400" />
            </div>
            <div style="margin-bottom:.75rem;display:flex;align-items:center;autocomplete:off">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem;flex:1">Token</label>
                <div style="display:flex;align-items:center;gap:.25rem;">
                    <input class="form-input" style="flex:1" @bind="_plexToken" type=@(_showPlexToken ? "text" : "password") placeholder="••••••••" autocomplete="off" />
                    <button class="btn btn-secondary" style="font-size:.75em;padding:.2rem .4rem" @onclick="() => _showPlexToken = !_showPlexToken">
                        @(_showPlexToken ? "Hide" : "Show")
                    </button>
                </div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <button class="btn btn-primary" @onclick="SavePlex" style="font-size:.85em">Save</button>
                <button class="btn btn-secondary" @onclick="TestPlex" disabled="@_plexTesting" style="font-size:.85em">
                    @(_plexTesting ? "Testing…" : "Test Connection")
                </button>
                @TestResultBadge(_plexResult)
            </div>
        </div>

        @* Jellyfin *@
        <div style="border:1px solid #333;border-radius:8px;padding:1.25rem">
            <h3 style="margin-top:0;font-size:1.1rem">Jellyfin</h3>
            <div style="margin-bottom:.75rem">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem">Server URL</label>
                <input class="form-input" style="width:100%" @bind="_jellyfinUrl" placeholder="http://jellyfin:8096" />
            </div>
            <div style="margin-bottom:.75rem;display:flex;align-items:center;autocomplete:off">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem;flex:1">API Key</label>
                <div style="display:flex;align-items:center;gap:.25rem;">
                    <input class="form-input" style="flex:1" @bind="_jellyfinKey" type=@(_showJellyfinKey ? "text" : "password") placeholder="••••••••" autocomplete="off" />
                    <button class="btn btn-secondary" style="font-size:.75em;padding:.2rem .4rem" @onclick="() => _showJellyfinKey = !_showJellyfinKey">
                        @(_showJellyfinKey ? "Hide" : "Show")
                    </button>
                </div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <button class="btn btn-primary" @onclick="SaveJellyfin" style="font-size:.85em">Save</button>
                <button class="btn btn-secondary" @onclick="TestJellyfin" disabled="@_jellyfinTesting" style="font-size:.85em">
                    @(_jellyfinTesting ? "Testing…" : "Test Connection")
                </button>
                @TestResultBadge(_jellyfinResult)
            </div>
        </div>

    </div>
</div>

@code {
    // ── State ─────────────────────────────────────────────────────────────

    private List<SyncJob> _jobs = new();
    private bool _triggering = false;
    private CancellationTokenSource _cts = new();

    private HashSet<int> _jikanYears = new() { DateTime.UtcNow.Year };
    private HashSet<string> _jikanSeasons = new(["spring", "summer", "fall", "winter"]);
    private string _jikanCustomYear = "";

    private string _sonarrUrl = "", _sonarrKey = "";
    private string _radarrUrl = "", _radarrKey = "";
    private string _plexUrl = "", _plexToken = "";
    private string _jellyfinUrl = "", _jellyfinKey = "";

    private bool _sonarrTesting, _radarrTesting, _plexTesting, _jellyfinTesting;
    private (bool Ok, string Msg)? _sonarrResult, _radarrResult, _plexResult, _jellyfinResult;

    // Visibility toggles for API keys
    private bool _showSonarrKey = false;
    private bool _showRadarrKey = false;
    private bool _showPlexToken = false;
    private bool _showJellyfinKey = false;

    // ── Lifecycle ──────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Task.WhenAll(LoadJobsAsync(), LoadSettingsAsync());
        StateHasChanged();
        StartPolling();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    // ── Polling ────────────────────────────────────────────────────────────

    private void StartPolling()
    {
        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        _ = PollAsync(_cts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            await Task.Delay(3000, ct);
            if (ct.IsCancellationRequested) break;

            // Both the DB read and the _jobs assignment must happen on the Blazor sync context
            // to avoid concurrent DbContext access and render-vs-update data races.
            var hasActive = false;
            await InvokeAsync(async () =>
            {
                await LoadJobsAsync();
                hasActive = _jobs.Any(j => j.Status is "Queued" or "Running");
                StateHasChanged();
            });

            if (!hasActive) break;
        }
    }

    // ── Data ───────────────────────────────────────────────────────────────

    private async Task LoadJobsAsync()
    {
        _jobs = await SyncJobService.GetRecentAsync();
    }

    private async Task LoadSettingsAsync()
    {
        _sonarrUrl   = await SettingsService.GetAsync("sonarr.url")    ?? "";
        _sonarrKey   = await SettingsService.GetAsync("sonarr.apikey") ?? "";
        _radarrUrl   = await SettingsService.GetAsync("radarr.url")    ?? "";
        _radarrKey   = await SettingsService.GetAsync("radarr.apikey") ?? "";
        _plexUrl     = await SettingsService.GetAsync("plex.url")      ?? "";
        _plexToken   = await SettingsService.GetAsync("plex.token")    ?? "";
        _jellyfinUrl = await SettingsService.GetAsync("jellyfin.url")  ?? "";
        _jellyfinKey = await SettingsService.GetAsync("jellyfin.apikey") ?? "";
    }

    // ── Sync triggers ─────────────────────────────────────────────────────

    private async Task TriggerSync(string jobType)
    {
        _triggering = true;
        try
        {
            string? parameters = null;
            if (jobType == "Jikan")
                parameters = JsonSerializer.Serialize(new
                {
                    years = _jikanYears.OrderBy(y => y),
                    seasons = _jikanSeasons.OrderBy(s => s)
                });

            await SyncJobService.QueueAsync(jobType, parameters);
            await LoadJobsAsync();
            StartPolling();
        }
        finally { _triggering = false; }
    }

    private IEnumerable<int> JikanYearList()
    {
        var current = DateTime.UtcNow.Year;
        var standard = Enumerable.Range(1960, current - 1960 + 2);
        return standard.Union(_jikanYears).OrderByDescending(y => y);
    }

    private bool IsValidCustomYear()
        => int.TryParse(_jikanCustomYear, out var y) && y >= 1900 && y <= 2200;

    private void AddCustomJikanYear()
    {
        if (int.TryParse(_jikanCustomYear, out var y) && y >= 1900 && y <= 2200)
        {
            _jikanYears.Add(y);
            _jikanCustomYear = "";
        }
    }

    private void OnCustomYearKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddCustomJikanYear();
    }

    private void ToggleJikanYear(int year, bool isChecked)
    {
        if (isChecked) _jikanYears.Add(year); else _jikanYears.Remove(year);
    }

    private void ToggleJikanSeason(string season, bool isChecked)
    {
        if (isChecked) _jikanSeasons.Add(season); else _jikanSeasons.Remove(season);
    }

    // ── Settings save ─────────────────────────────────────────────────────

    private async Task SaveSonarr()
    {
        await SettingsService.SetAsync("sonarr.url", _sonarrUrl.Trim());
        await SettingsService.SetAsync("sonarr.apikey", _sonarrKey.Trim());
        _sonarrResult = (true, "Saved");
    }

    private async Task SaveRadarr()
    {
        await SettingsService.SetAsync("radarr.url", _radarrUrl.Trim());
        await SettingsService.SetAsync("radarr.apikey", _radarrKey.Trim());
        _radarrResult = (true, "Saved");
    }

    private async Task SavePlex()
    {
        await SettingsService.SetAsync("plex.url", _plexUrl.Trim());
        await SettingsService.SetAsync("plex.token", _plexToken.Trim());
        _plexResult = (true, "Saved");
    }

    private async Task SaveJellyfin()
    {
        await SettingsService.SetAsync("jellyfin.url", _jellyfinUrl.Trim());
        await SettingsService.SetAsync("jellyfin.apikey", _jellyfinKey.Trim());
        _jellyfinResult = (true, "Saved");
    }

    // ── Connection tests ──────────────────────────────────────────────────

    private async Task TestSonarr()
    {
        _sonarrTesting = true; _sonarrResult = null;
        _sonarrResult = await TestArrAsync(NormalizeUrl(_sonarrUrl), _sonarrKey, "Sonarr");
        _sonarrTesting = false;
    }

    private async Task TestRadarr()
    {
        _radarrTesting = true; _radarrResult = null;
        _radarrResult = await TestArrAsync(NormalizeUrl(_radarrUrl), _radarrKey, "Radarr");
        _radarrTesting = false;
    }

    private async Task TestPlex()
    {
        _plexTesting = true; _plexResult = null;
        _plexResult = await TestPlexAsync(NormalizeUrl(_plexUrl), _plexToken);
        _plexTesting = false;
    }

    private async Task TestJellyfin()
    {
        _jellyfinTesting = true; _jellyfinResult = null;
        _jellyfinResult = await TestJellyfinAsync(NormalizeUrl(_jellyfinUrl), _jellyfinKey);
        _jellyfinTesting = false;
    }

    private async Task<(bool Ok, string Msg)> TestArrAsync(string url, string apiKey, string name)
    {
        if (string.IsNullOrWhiteSpace(url)) return (false, "URL is required");
        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(15); // Match the timeout used in actual service calls
            using var req = new HttpRequestMessage(HttpMethod.Get, $"{url}/api/v3/system/status");
            if (!string.IsNullOrWhiteSpace(apiKey))
                req.Headers.Add("X-Api-Key", apiKey);
            var res = await client.SendAsync(req);
            if (res.IsSuccessStatusCode) return (true, "Connected");

            var body = await SafeReadBodyAsync(res);
            var reason = string.IsNullOrWhiteSpace(res.ReasonPhrase) ? "" : $" {res.ReasonPhrase}";
            var detail = string.IsNullOrWhiteSpace(body) ? "" : $" — {body}";
            return (false, $"HTTP {(int)res.StatusCode}{reason}{detail}");
        }
        catch (HttpRequestException ex)
        {
            // Handle network-related errors specifically
            return (false, $"Network error: {ex.Message}");
        }
        catch (TaskCanceledException ex)
        {
            // Handle timeouts
            return (false, "Connection timed out - check if the URL is correct and the service is reachable");
        }
        catch (Exception ex)
        {
            // Handle all other exceptions
            return (false, $"Error: {ex.Message}");
        }
    }

    private static async Task<string> SafeReadBodyAsync(HttpResponseMessage res)
    {
        try
        {
            var body = await res.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return string.Empty;
            body = body.Trim();
            const int max = 500;
            return body.Length > max ? body[..max] + "…" : body;
        }
        catch { return string.Empty; }
    }

    private static string FormatException(Exception ex)
    {
        var messages = new List<string>();
        for (var cur = ex; cur is not null; cur = cur.InnerException)
            if (!string.IsNullOrWhiteSpace(cur.Message))
                messages.Add(cur.Message.Trim());
        return messages.Count == 0 ? ex.GetType().Name : string.Join(" → ", messages);
    }

    private async Task<(bool Ok, string Msg)> TestPlexAsync(string url, string token)
    {
        if (string.IsNullOrWhiteSpace(url)) return (false, "URL is required");
        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(15); // Match the timeout used in actual service calls
            var testUrl = string.IsNullOrWhiteSpace(token)
                ? $"{url}/identity"
                : $"{url}/identity?X-Plex-Token={Uri.EscapeDataString(token)}";
            var res = await client.GetAsync(testUrl);
            return res.IsSuccessStatusCode
                ? (true, "Connected")
                : (false, $"HTTP {(int)res.StatusCode} - {res.ReasonPhrase}");
        }
        catch (HttpRequestException ex)
        {
            // Handle network-related errors specifically
            return (false, $"Network error: {ex.Message}");
        }
        catch (TaskCanceledException ex)
        {
            // Handle timeouts
            return (false, "Connection timed out - check if the URL is correct and the service is reachable");
        }
        catch (Exception ex)
        {
            // Handle all other exceptions
            return (false, $"Error: {ex.Message}");
        }
    }

    private async Task<(bool Ok, string Msg)> TestJellyfinAsync(string url, string apiKey)
    {
        if (string.IsNullOrWhiteSpace(url)) return (false, "URL is required");
        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(15); // Match the timeout used in actual service calls
            using var req = new HttpRequestMessage(HttpMethod.Get, $"{url}/System/Info/Public");
            if (!string.IsNullOrWhiteSpace(apiKey))
                req.Headers.Add("X-MediaBrowser-Token", apiKey);
            var res = await client.SendAsync(req);
            return res.IsSuccessStatusCode
                ? (true, "Connected")
                : (false, $"HTTP {(int)res.StatusCode} - {res.ReasonPhrase}");
        }
        catch (HttpRequestException ex)
        {
            // Handle network-related errors specifically
            return (false, $"Network error: {ex.Message}");
        }
        catch (TaskCanceledException ex)
        {
            // Handle timeouts
            return (false, "Connection timed out - check if the URL is correct and the service is reachable");
        }
        catch (Exception ex)
        {
            // Handle all other exceptions
            return (false, $"Error: {ex.Message}");
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    private SyncJob? IsActive(string type)
        => _jobs.FirstOrDefault(j => j.JobType == type && j.Status is "Queued" or "Running");

    private SyncJob? LastJob(string type)
        => _jobs.FirstOrDefault(j => j.JobType == type && j.Status is "Completed" or "Failed");

    private static string NormalizeUrl(string url)
    {
        url = url.Trim().TrimEnd('/');
        if (!url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
            !url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            url = "http://" + url;
        return url;
    }

    private static string FormatAgo(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private static string FormatDuration(SyncJob job)
    {
        if (job.StartedAt == null) return "—";
        var end = job.FinishedAt ?? DateTime.UtcNow;
        var span = end - job.StartedAt.Value;
        return span.TotalMinutes >= 1
            ? $"{(int)span.TotalMinutes}m {span.Seconds}s"
            : $"{span.Seconds}s";
    }

    private static RenderFragment StatusBadge(string status) => builder =>
    {
        var (bg, label) = status switch
        {
            "Queued"    => ("#6c757d", "Queued"),
            "Running"   => ("#0d6efd", "Running"),
            "Completed" => ("#198754", "Completed"),
            _           => ("#dc3545", "Failed")
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style", $"background:{bg};color:#fff;padding:.15rem .45rem;border-radius:4px;font-size:.8em");
        builder.AddContent(2, label);
        builder.CloseElement();
    };

    private static RenderFragment TestResultBadge((bool Ok, string Msg)? result) => builder =>
    {
        if (result == null) return;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style", $"color:{(result.Value.Ok ? "#198754" : "#dc3545")};font-size:.85em");
        builder.AddContent(2, (result.Value.Ok ? "✓ " : "✗ ") + result.Value.Msg);
        builder.CloseElement();
    };
}
