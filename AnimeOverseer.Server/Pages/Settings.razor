                <div style="display:flex;align-items:center;gap:.25rem;">
                    <input class="form-input" style="flex:1" @bind="_plexToken" type=@(_showPlexToken ? "text" : "password") placeholder="••••••••" autocomplete="off" />
                    <button class="btn btn-secondary" style="font-size:.75em;padding:.2rem .4rem" @onclick="() => _showPlexToken = !_showPlexToken">
                        @(_showPlexToken ? "Hide" : "Show")
                    </button>
                </div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <button class="btn btn-primary" @onclick="SavePlex" style="font-size:.85em">Save</button>
                <button class="btn btn-secondary" @onclick="TestPlex" disabled="@_plexTesting" style="font-size:.85em">
                    @(_plexTesting ? "Testing…" : "Test Connection")
                </button>
                @TestResultBadge(_plexResult)
            </div>
        </div>

        @* Jellyfin *@
        <div class="settings-card">
            <h3 style="margin-top:0;font-size:1.1rem">Jellyfin</h3>
            <div style="margin-bottom:.75rem">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem">Server URL</label>
                <input class="form-input" style="width:100%" @bind="_jellyfinUrl" placeholder="http://jellyfin:8096" />
            </div>
            <div style="margin-bottom:.75rem;display:flex;align-items:center;autocomplete:off">
                <label style="display:block;font-size:.85em;color:#aaa;margin-bottom:.25rem;flex:1">API Key</label>
                <div style="display:flex;align-items:center;gap:.25rem;">
                    <input class="form-input" style="flex:1" @bind="_jellyfinKey" type=@(_showJellyfinKey ? "text" : "password") placeholder="••••••••" autocomplete="off" />
                    <button class="btn btn-secondary" style="font-size:.75em;padding:.2rem .4rem" @onclick="() => _showJellyfinKey = !_showJellyfinKey">
                        @(_showJellyfinKey ? "Hide" : "Show")
                    </button>
                </div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                <button class="btn btn-primary" @onclick="SaveJellyfin" style="font-size:.85em">Save</button>
                <button class="btn btn-secondary" @onclick="TestJellyfin" disabled="@_jellyfinTesting" style="font-size:.85em">
                    @(_jellyfinTesting ? "Testing…" : "Test Connection")
                </button>
                @TestResultBadge(_jellyfinResult)
            </div>
        </div>

    </div>
    }
</div>

@code {
    private enum SettingsTab { Sources, Servers, History, Storage, Review }

    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    // ── State ─────────────────────────────────────────────────────────────

    private List<SyncJob> _jobs = new();
    private List<SyncJob> _sourceJobs = new();
    private List<IntegrationSchedule> _integrationSchedules = new();
    private IntegrationSchedule? _editingSchedule;
    private bool _restartScheduleOnSave;
    private int _totalJobs;
    private int _jobsPage = 1;
    private int _jobsPerPage = 10;
    private SettingsTab _activeTab = SettingsTab.Sources;
    private bool _triggering = false;
    private string? _integrationMessage;
    private bool _loadingStorage;
    private StorageUsage? _storageUsage;
    private CancellationTokenSource _cts = new();

    private HashSet<int> _jikanYears = new() { DateTime.UtcNow.Year };
    private HashSet<string> _jikanSeasons = new(["spring", "summer", "fall", "winter"]);
    private string _jikanCustomYear = "";

    private string _sonarrUrl = "", _sonarrKey = "";
    private string _radarrUrl = "", _radarrKey = "";
    private string _plexUrl = "", _plexToken = "";
    private string _jellyfinUrl = "", _jellyfinKey = "";
    private string _malClientId = "";
    private string _animeScheduleApplicationToken = "";
    private bool _malSaving, _animeScheduleSaving;
    private (bool Ok, string Msg)? _malResult, _animeScheduleResult;

    private bool _sonarrTesting, _radarrTesting, _plexTesting, _jellyfinTesting;
    private (bool Ok, string Msg)? _sonarrResult, _radarrResult, _plexResult, _jellyfinResult;

    // Visibility toggles for API keys
    private bool _showSonarrKey = false;
    private bool _showRadarrKey = false;
    private bool _showPlexToken = false;
    private bool _showJellyfinKey = false;

    private string TabClass(SettingsTab tab) => _activeTab == tab ? "active" : "";

    private static string TabUrl(SettingsTab tab) => tab switch
    {
        SettingsTab.Sources => "/settings",
        SettingsTab.Servers => "/settings?tab=servers",
        SettingsTab.History => "/settings?tab=history",
        SettingsTab.Storage => "/settings?tab=storage",
        SettingsTab.Review => "/settings?tab=review",
        _ => "/settings"
    };

    // ── Lifecycle ──────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        _activeTab = Tab?.ToLowerInvariant() switch
        {
            "servers" => SettingsTab.Servers,
            "history" => SettingsTab.History,
            "storage" => SettingsTab.Storage,
            "review" => SettingsTab.Review,
            _ => SettingsTab.Sources
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Task.WhenAll(LoadJobsAsync(), LoadSettingsAsync(), LoadStorageUsageAsync(), LoadIntegrationSchedulesAsync());
        StateHasChanged();
        StartPolling();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    // ── Polling ────────────────────────────────────────────────────────────

    private void StartPolling()
    {
        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        _ = PollAsync(_cts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            await Task.Delay(3000, ct);
            if (ct.IsCancellationRequested) break;

            // Both the DB read and the _jobs assignment must happen on the Blazor sync context
            // to avoid concurrent DbContext access and render-vs-update data races.
            var hasActive = false;
            await InvokeAsync(async () =>
            {
                await LoadJobsAsync();
                hasActive = _jobs.Any(j => j.Status is "Queued" or "Running");
                StateHasChanged();
            });

            if (!hasActive) break;
        }
    }

    // ── Data ───────────────────────────────────────────────────────────────

    private async Task LoadJobsAsync()
    {
        _totalJobs = await SyncJobService.GetCountAsync();
        _jobsPage = Math.Min(_jobsPage, PageCount);
        _jobs = await SyncJobService.GetRecentAsync((_jobsPage - 1) * _jobsPerPage, _jobsPerPage);
        // Keep enough recent jobs for the data-source cards independently of the current history page.
        _sourceJobs = await SyncJobService.GetRecentAsync(count: 30);
    }

    private async Task LoadIntegrationSchedulesAsync()
        => _integrationSchedules = await IntegrationScheduleService.GetAllAsync();

    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)_totalJobs / _jobsPerPage));

    private bool HasQueuedJobs => _jobs.Any(j => j.Status == "Queued");

    private async Task GoToPageAsync(int page)
    {
        _jobsPage = Math.Clamp(page, 1, PageCount);
        await LoadJobsAsync();
    }

    private async Task ChangePageSizeAsync()
    {
        _jobsPage = 1;
        await LoadJobsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        _sonarrUrl   = await SettingsService.GetAsync("sonarr.url")    ?? "";
        _sonarrKey   = await SettingsService.GetAsync("sonarr.apikey") ?? "";
        _radarrUrl   = await SettingsService.GetAsync("radarr.url")    ?? "";
        _radarrKey   = await SettingsService.GetAsync("radarr.apikey") ?? "";
        _plexUrl     = await SettingsService.GetAsync("plex.url")      ?? "";
        _plexToken   = await SettingsService.GetAsync("plex.token")    ?? "";
        _jellyfinUrl = await SettingsService.GetAsync("jellyfin.url")  ?? "";
        _jellyfinKey = await SettingsService.GetAsync("jellyfin.apikey") ?? "";
        _malClientId = await SettingsService.GetAsync("myanimelist.clientId") ?? "";
        _animeScheduleApplicationToken = await SettingsService.GetAsync("animeschedule.applicationToken") ?? "";
    }

    private async Task LoadStorageUsageAsync()
    {
        _loadingStorage = true;
        try
        {
            _storageUsage = await StorageUsageService.GetUsageAsync();
        }
        finally
        {
            _loadingStorage = false;
        }
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var size = (double)bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return unit == 0 ? $"{size:N0} {units[unit]}" : $"{size:N1} {units[unit]}";
    }

    // ── Sync triggers ─────────────────────────────────────────────────────

    private async Task TriggerSync(string jobType)
    {
        _triggering = true;
        try
        {
            string? parameters = null;
            if (jobType is "AniList" or "MyAnimeList" or "AnimeSchedule")
                parameters = JsonSerializer.Serialize(new
                {
                    years = _jikanYears.OrderBy(y => y),
                    seasons = _jikanSeasons.OrderBy(s => s)
                });

            await SyncJobService.QueueAsync(jobType, parameters);
            await LoadJobsAsync();
            StartPolling();
        }
        finally { _triggering = false; }
    }

    private static readonly (int Value, string Name)[] DaysOfWeek =
        [(0, "Sunday"), (1, "Monday"), (2, "Tuesday"), (3, "Wednesday"), (4, "Thursday"), (5, "Friday"), (6, "Saturday")];
    private static readonly string[] SeasonOptions = ["winter", "spring", "summer", "fall"];

    private void NewSchedule()
    {
        _restartScheduleOnSave = false;
        _editingSchedule = new IntegrationSchedule
        {
            Name = "New catalogue schedule",
            Source = "AniList",
            Enabled = true,
            StartAt = DateTime.UtcNow.AddMinutes(5),
            WeekdaysJson = JsonSerializer.Serialize(new[] { (int)DateTime.UtcNow.DayOfWeek })
        };
    }

    private void EditSchedule(IntegrationSchedule schedule)
    {
        _restartScheduleOnSave = false;
        _editingSchedule = JsonSerializer.Deserialize<IntegrationSchedule>(JsonSerializer.Serialize(schedule));
    }

    private void CancelSchedule() => _editingSchedule = null;
    private static void StartScheduleImmediately(IntegrationSchedule schedule) => schedule.StartAt = DateTime.UtcNow;

    private async Task SaveScheduleAsync()
    {
        if (_editingSchedule is null) return;
        if (IntegrationScheduleService.SeasonsFor(_editingSchedule).Length == 0)
        {
            _integrationMessage = "Choose at least one season for the scheduled job.";
            return;
        }
        await IntegrationScheduleService.SaveAsync(_editingSchedule, _restartScheduleOnSave);
        await LoadIntegrationSchedulesAsync();
        _editingSchedule = null;
        _integrationMessage = "Schedule saved.";
    }

    private async Task DeleteScheduleAsync(int id)
    {
        await IntegrationScheduleService.DeleteAsync(id);
        await LoadIntegrationSchedulesAsync();
    }

    private SyncJob? ActiveMigrationFor(string source)
        => _sourceJobs.FirstOrDefault(job => job.JobType == source && job.Status is "Queued" or "Running" && IsInitialMigration(job));

    private static bool IsInitialMigration(SyncJob job)
    {
        if (string.IsNullOrWhiteSpace(job.Parameters)) return false;
        try
        {
            using var document = JsonDocument.Parse(job.Parameters);
            return document.RootElement.TryGetProperty("initialImport", out var initialImport) && initialImport.GetBoolean();
        }
        catch (JsonException) { return false; }
    }

    private async Task CancelMigrationAsync(int jobId)
    {
        if (await SyncJobService.CancelAsync(jobId))
        {
            _integrationMessage = "Migration cancellation requested. No following season will be queued.";
            await LoadJobsAsync();
            StartPolling();
        }
    }

    private static string RecurrenceUnit(string type, int interval) => type switch
    {
        "Once" => "once",
        "Daily" => interval == 1 ? "day" : "days",
        "Weekly" => interval == 1 ? "week" : "weeks",
        "Monthly" => interval == 1 ? "month" : "months",
        _ => interval == 1 ? "year" : "years"
    };

    private bool ScheduleHasWeekday(IntegrationSchedule schedule, int day)
        => ParseInts(schedule.WeekdaysJson).Contains(day);
    private void ToggleScheduleWeekday(IntegrationSchedule schedule, int day, bool selected)
    {
        var days = ParseInts(schedule.WeekdaysJson);
        if (selected) days.Add(day); else days.Remove(day);
        schedule.WeekdaysJson = JsonSerializer.Serialize(days.Order());
    }
    private bool ScheduleHasSeason(IntegrationSchedule schedule, string season)
        => IntegrationScheduleService.SeasonsFor(schedule).Contains(season);
    private void ToggleScheduleSeason(IntegrationSchedule schedule, string season, bool selected)
    {
        var seasons = IntegrationScheduleService.SeasonsFor(schedule).ToHashSet();
        if (selected) seasons.Add(season); else seasons.Remove(season);
        schedule.SeasonsJson = JsonSerializer.Serialize(seasons.Order());
    }
    private static void UseRemainingSeasons(IntegrationSchedule schedule)
    {
        var current = DateTime.UtcNow.Month switch { <= 2 => 0, <= 5 => 1, <= 8 => 2, <= 11 => 3, _ => 0 };
        schedule.SeasonsJson = JsonSerializer.Serialize(SeasonOptions.Skip(current));
    }
    private static HashSet<int> ParseInts(string json)
    {
        try { return JsonSerializer.Deserialize<int[]>(json)?.ToHashSet() ?? []; }
        catch (JsonException) { return []; }
    }
    private IReadOnlyList<DateTime> PreviewOccurrences(IntegrationSchedule schedule)
        => IntegrationScheduleService.GetNextOccurrences(schedule, 8);
    private static string Capitalize(string value) => char.ToUpperInvariant(value[0]) + value[1..];
    private static string YearScopeText(IntegrationSchedule schedule)
    {
        var start = DateTime.UtcNow.Year + schedule.YearOffset;
        var end = start + schedule.YearCount - 1;
        return start == end ? start.ToString() : $"{start}–{end}";
    }
    private static string DescribeSchedule(IntegrationSchedule s)
        => $"{(s.RecurrenceType == "Once" ? "One-off" : $"Every {s.Interval} {RecurrenceUnit(s.RecurrenceType, s.Interval)}")} · {YearScopeText(s)} · {string.Join(", ", IntegrationScheduleService.SeasonsFor(s).Select(Capitalize))}";

    private async Task RunQueuedJobsNowAsync()
    {
        SyncJobTrigger.Signal();
        await LoadJobsAsync();
        StartPolling();
    }

    private IEnumerable<int> JikanYearList()
    {
        var current = DateTime.UtcNow.Year;
        var standard = Enumerable.Range(1960, current - 1960 + 2);
        return standard.Union(_jikanYears).OrderByDescending(y => y);
    }

    private bool IsValidCustomYear()
        => int.TryParse(_jikanCustomYear, out var y) && y >= 1900 && y <= 2200;

    private void AddCustomJikanYear()
